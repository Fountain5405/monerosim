diff --git a/tests/unit_tests/test_id_consistency.cpp b/tests/unit_tests/test_id_consistency.cpp
new file mode 100644
index 000000000..48ce5e92d
--- /dev/null
+++ b/tests/unit_tests/test_id_consistency.cpp
@@ -0,0 +1,65 @@
+// Copyright (c) 2026, The Monero Project
+//
+// Simulation only: unit tests for --sim-enforce-id-consistency's evidence rules (R1 shared id
+// on direct observation with grace, R2 self-contradiction). Hearsay has no API — by design.
+
+#include "gtest/gtest.h"
+#include "p2p/id_evidence_map.h"
+
+#define IDA_ADDR(a,b,c,d,e) epee::net_utils::ipv4_network_address{MAKE_IP(a,b,c,d),e}
+
+TEST(id_consistency, shared_id_within_grace_flags_older_address)
+{
+  nodetool::id_evidence_map m{3600};
+  auto v = m.observe(42, IDA_ADDR(1,2,3,4, 80), 1000);
+  ASSERT_TRUE(v.empty());
+  v = m.observe(42, IDA_ADDR(5,6,7,8, 80), 1010);   // same id, second address, within grace
+  ASSERT_EQ(v.size(), 1u);                          // the older address violates
+  ASSERT_EQ(v[0].as<const epee::net_utils::ipv4_network_address>().ip(), MAKE_IP(1,2,3,4));
+  ASSERT_TRUE(m.address_in_violation(IDA_ADDR(1,2,3,4, 80), 1010));
+  ASSERT_FALSE(m.address_in_violation(IDA_ADDR(5,6,7,8, 80), 1010)); // freshest wins
+  uint64_t seen_id = 0;
+  ASSERT_TRUE(m.last_observed_id(IDA_ADDR(5,6,7,8, 80), seen_id) && seen_id == 42);
+}
+
+TEST(id_consistency, migration_beyond_grace_is_clean)
+{
+  nodetool::id_evidence_map m{3600};
+  m.observe(42, IDA_ADDR(1,2,3,4, 80), 1000);
+  auto v = m.observe(42, IDA_ADDR(5,6,7,8, 80), 1000 + 3600 + 1); // honest IP move after grace
+  ASSERT_TRUE(v.empty());
+  ASSERT_FALSE(m.address_in_violation(IDA_ADDR(1,2,3,4, 80), 1000 + 3600 + 1));
+}
+
+TEST(id_consistency, proxy_returning_to_parked_address_flags)
+{
+  nodetool::id_evidence_map m{3600};
+  m.observe(42, IDA_ADDR(1,2,3,4, 80), 1000);
+  m.observe(42, IDA_ADDR(5,6,7,8, 80), 1010);
+  auto v = m.observe(42, IDA_ADDR(1,2,3,4, 80), 1020); // the old address is live again
+  ASSERT_EQ(v.size(), 1u);
+  ASSERT_EQ(v[0].as<const epee::net_utils::ipv4_network_address>().ip(), MAKE_IP(5,6,7,8));
+  ASSERT_TRUE(m.address_in_violation(IDA_ADDR(5,6,7,8, 80), 1020));
+}
+
+TEST(id_consistency, id_change_at_same_address_never_flags)
+{
+  nodetool::id_evidence_map m{3600};
+  m.observe(7, IDA_ADDR(1,2,3,4, 80), 1000);          // before restart
+  auto v = m.observe(99, IDA_ADDR(1,2,3,4, 80), 1001); // new random id, same address
+  ASSERT_TRUE(v.empty());
+  ASSERT_FALSE(m.address_in_violation(IDA_ADDR(1,2,3,4, 80), 1001));
+}
+
+TEST(id_consistency, contradiction_marks_address_and_expires)
+{
+  nodetool::id_evidence_map m{3600};
+  ASSERT_FALSE(m.enabled() == false && true); // enabled with grace 3600
+  m.mark_contradiction(IDA_ADDR(1,2,3,4, 80), 1000);
+  ASSERT_TRUE(m.contradiction_recent(IDA_ADDR(1,2,3,4, 80), 1000 + 3599));
+  ASSERT_FALSE(m.contradiction_recent(IDA_ADDR(1,2,3,4, 80), 1000 + 3601));
+  nodetool::id_evidence_map off{0};
+  off.observe(1, IDA_ADDR(1,2,3,4, 80), 1000);        // G=0: inert
+  off.mark_contradiction(IDA_ADDR(1,2,3,4, 80), 1000);
+  ASSERT_FALSE(off.contradiction_recent(IDA_ADDR(1,2,3,4, 80), 1000));
+}
