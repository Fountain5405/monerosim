+/* SIMULATION ONLY (monerosim patches/monero-sim-fixed-randomx-seed.patch). At block 2048 + 64 + 1 = 2113
+   (about 20 h into a Shadow run) the stock rule moves the RandomX seed, and every node of a simulated
+   network derives its new 256 MB cache in the same minute; KSM cannot merge them as fast, and a 450-daemon
+   run grows by 100 GB or more. Pinning the seed height to 0 removes the epoch change. */
+static int g_sim_fixed_seed = 0;
+void rx_set_fixed_seed(int fixed) { g_sim_fixed_seed = fixed; }
