+      if (found || data.height != parent_height)
+        return true;
+      ++at_height;
+      cryptonote::blobdata blob;
+      cryptonote::alt_block_data_t d2;
+      if (!m_db->get_alt_block(alt_id, &d2, &blob))
+        return true;
+      cryptonote::block alt_bl;
+      if (!cryptonote::parse_and_validate_block_from_blob(blob, alt_bl))
+        return true;
+      if (alt_bl.prev_id != parent_prev)
+      {
+        ++not_sibling;
+        return true;
+      }
+      if (!sim_pop_in_time(alt_id, parent_height))
+      {
+        ++late;
+        return true;
+      }
+      header_blob = get_block_hashing_blob(alt_bl);
+      found = true;
+      return true;
+  });
+  if (!found && at_height)
+    MINFO("SIM-PoP: template at height " << parent_height + 1 << ": " << at_height << " alt block(s) at the parent height, "
+          << not_sibling << " not sibling, " << late << " late -- no uncle embedded");
+  return found;
+}
+
+// Parse a PoW-header blob (get_block_hashing_blob output): after the
+// serialized block_header come the 32-byte tx-tree hash and then the
+// tx_hashes-count varint, which must consume the blob exactly. (The
+// tree-hash offset matters: a parser that starts the varint right after
+// the header lands on the tree hash and rejects every real blob — the
+// defect that silently zeroed the uncle-header bonus in every run before
+// 2026-09-24.) Shared by the uncle-header verifier and the SoP workshare
+// pool.
+static bool sim_parse_pow_header(const std::string &blob, block_header &bh, uint64_t &tx_count)
+{
+  std::vector<uint8_t> v(blob.begin(), blob.end());
+  binary_archive<false> ar{epee::to_span(v)};
+  if (!::do_serialize(ar, bh))
+    return false;
+  blobdata hb;
+  if (!::serialization::dump_binary(bh, hb))
+    return false;
+  if (hb.empty() || hb.size() + 32 >= v.size())
+    return false;
+  tx_count = 0;
+  {
+    size_t pos = hb.size() + 32; uint64_t shift = 0;   // skip the tx-tree hash
+    bool terminated = false;
+    while (pos < v.size())
+    {
+      const uint8_t byte = v[pos++];
+      tx_count |= (uint64_t)(byte & 0x7f) << shift;
+      shift += 7;
+      if (!(byte & 0x80)) { terminated = true; break; }
+    }
+    if (!terminated || pos != v.size())
+      return false;           // trailing junk / unterminated varint
+  }
+  return true;
+}
+
+// Sibling anchor for an embedded uncle: the containing block's grandparent,
+// i.e. its PARENT's prev_id. Read it from the parent block itself (main or
+// alt via get_block_by_hash), never from the main chain at height-2: when the
+// containing block sits three or more deep in an alt chain, main[height-2]
+// is a different block and every legitimate uncle in that chain was REJECTED
+// as "not a sibling of the parent" (2026-09-26 patch review, finding 5).
+bool Blockchain::sim_pop_parent_prev(const block &b, uint64_t height, crypto::hash &parent_prev) const
+{
+  block parent;
+  if (!get_block_by_hash(b.prev_id, parent))
+  {
+    MINFO("SIM-PoP: block at height " << height << " has unknown parent " << b.prev_id << " (uncle bonus 0)");
+    return false;
+  }
+  parent_prev = parent.prev_id;
+  return true;
+}
+
+// Weight side (trustless per MRL #144): an embedded header counts when its
+// PoW meets the difficulty at the uncle height and its prev_id makes it a
+// sibling of the containing block's parent. In-time-ness: a block we
+// RECEIVED is held to the lateness rule; one we never received still
+// counts — that self-contained verifiability is the point of the 80-byte
+// header form (the DEVIATED id-in-nonce variant cannot do this).
+uint64_t Blockchain::sim_pop_uncle_bonus_header(const block &b, uint64_t height) const
+{
+  if (height < 2)
+    return 0;
+  std::vector<tx_extra_field> fields;
+  if (!parse_tx_extra(b.miner_tx.extra, fields))
+  {
+    MINFO("SIM-PoP: block at height " << height << " tx_extra UNPARSABLE (uncle bonus 0)");
+    return 0;
+  }
+  crypto::hash parent_prev;
+  if (!sim_pop_parent_prev(b, height, parent_prev))
+    return 0;
+  uint64_t bonus = 0;
+  for (const auto &f : fields)
+  {
+    if (f.which() != 6)          // variant: ..., 5 minergate, 6 sim_uncle
+      continue;
+    const std::string &blob = boost::get<tx_extra_sim_uncle>(f).data;
+
+    // Re-derive the uncle id; re-parse the header (canonical form only);
+    // a reconstructed block must reproduce the blob byte-for-byte or the
+    // header counts for nothing.
+    crypto::hash uncle_id;
+    {
+      // The uncle's block id = keccak(varint(size) || hashing blob), exactly
+      // what calculate_block_hash computes (get_object_hash serializes the
+      // blob as a length-prefixed string). A bare keccak of the blob is NOT
+      // the block id, so the lateness lookup below never matched before.
+      blobdata pre;
+      sim_sop_append_varint(pre, blob.size());
+      pre += blob;
+      get_blob_hash(pre, uncle_id);
+    }
+    block_header bh;
+    uint64_t tx_count = 0;
+    if (!sim_parse_pow_header(blob, bh, tx_count))   // canonical header + tree hash + exact-fit count
+    {
+      MINFO("SIM-PoP: uncle header at height " << height << " REJECTED (unparsable, " << blob.size() << " B)");
+      continue;
+    }
+    (void)tx_count;
+    if (bh.prev_id != parent_prev)
+    {
+      MINFO("SIM-PoP: uncle " << uncle_id << " at height " << height << " REJECTED (not a sibling of the parent)");
+      continue;                 // not a sibling of our parent (MRL #144 height check)
+    }
+
+    // PoW: hash the embedded blob ITSELF (blobdata overload). Rebuilding a
+    // block from the header and hashing that recomputes the tree hash from
+    // an empty coinbase (and a wrong tx count), so it can never reproduce
+    // the mined blob -- the comparison that kept this bonus inert in every
+    // run through 2026-09-25 (review F4).
+    crypto::hash pow;
+    if (!get_block_longhash(this, blob, pow, height - 1, bh.major_version, nullptr, 0)
+        || !check_hash(pow, sim_block_difficulty_at(height - 1)))
+    {
+      MINFO("SIM-PoP: uncle " << uncle_id << " at height " << height << " REJECTED (PoW below difficulty "
+            << sim_block_difficulty_at(height - 1) << ")");
+      continue;
+    }
+
+    // Lateness: received uncles are held to Def.1; never-received ones
+    // count (trustless — the PoW above is their proof of reality).
+    auto it = m_sim_recv.find(uncle_id);
+    if (it != m_sim_recv.end() && !sim_pop_in_time(uncle_id, height - 1))
+    {
+      MINFO("SIM-PoP: uncle " << uncle_id << " at height " << height << " REJECTED (received late)");
+      continue;
+    }
+    MINFO("SIM-PoP: uncle " << uncle_id << " at height " << height << " COUNTED"
+          << (it == m_sim_recv.end() ? " (never received: trustless)" : ""));
+    ++bonus;
+  }
+  return bonus;
+}
+
+// SIMULATION ONLY (Share-or-Perish, MRL #146, step 2): admit a workshare
+// into the per-node pool. Validation here is intentionally light — canonical
+// parse plus "continues a block we know" (main or alt at height-1); the full
+// PoW check (>= diff/w at this height) is deferred to weight time, exactly
+// like embedded uncle headers. First-seen time goes into the shared
+// m_sim_recv ledger so l_b and l_w read one clock. Returns true only for a
+// NEW share (duplicates keep their first-seen and do not re-relay).
+// Slot rule (MRL #146 author, 2026-10-21 meeting: a colliding share is seen
+// but does not enter the pool): if the pool already holds a share on the same
+// parent with the same slot (minor_version), the later one only gets its
+// first-seen timestamp (for the lateness check); it is not pooled, so it is
+// neither relayed nor does it invalidate the template.
+bool Blockchain::sim_add_workshare(const blobdata &blob, uint64_t height, bool local, crypto::hash &id, bool *extends_tip,
+                                   crypto::hash *prev_out, uint64_t *slot_out)
+{
+  if (extends_tip)
+    *extends_tip = false;
+  if (!m_sim_sop_enabled)
+    return false;   // dormant node: no pool, no relay (stock behaviour in mixed networks)
+  CRITICAL_REGION_LOCAL(m_blockchain_lock);
+  if (height < 1 || height > get_current_blockchain_height() + 10 * m_sim_sop_w)
+  {
+    MINFO("SIM-SoP: share rejected (height " << height << " vs chain height " << get_current_blockchain_height() << ")");
+    return false;
+  }
+  block_header bh;
+  uint64_t tx_count = 0;
+  if (!sim_parse_pow_header(blob, bh, tx_count))
+  {
+    MINFO("SIM-SoP: share rejected (unparsable, " << blob.size() << " B)");
+    return false;
+  }
+
+  // The share must continue something we know at height-1: the main-chain
+  // block, or an alt block competing there (during races the template's
+  // parent can itself be off the main chain).
+  const uint64_t top_h = get_current_blockchain_height() - 1;
+  const bool parent_on_main = height - 1 <= top_h && get_block_id_by_height(height - 1) == bh.prev_id;
+  bool parent_known = parent_on_main;
+  if (!parent_known)
+  {
+    m_db->for_all_alt_blocks([&](const crypto::hash &alt_id, const alt_block_data_t &data, const cryptonote::blobdata_ref*) {
+        if (data.height == height - 1 && alt_id == bh.prev_id)
+          parent_known = true;
+        return true;
+    });
+  }
+  if (!parent_known)
+  {
+    MINFO("SIM-SoP: share rejected (unknown parent " << bh.prev_id << " at height " << (height - 1) << ")");
+    return false;
+  }
+  if (!parent_on_main)
+  {
+    // alternate workshare (spec 2.3): the alt chain must fork within 10*w of the main chain
+    crypto::hash cur = bh.prev_id;
+    uint64_t steps = 0;
+    alt_block_data_t alt_data;
+    cryptonote::blobdata alt_blob;
+    while (steps < 10 * m_sim_sop_w && m_db->get_alt_block(cur, &alt_data, &alt_blob))
+    {
+      cryptonote::block b;
+      if (!parse_and_validate_block_from_blob(alt_blob, b))
+        break;
+      cur = b.prev_id;
+      ++steps;
+    }
+    if (steps >= 10 * m_sim_sop_w || !m_db->block_exists(cur))
+    {
+      MINFO("SIM-SoP: share rejected (alternate chain forks " << steps << "+ blocks deep)");
+      return false;
+    }
+  }
+
+  cn_fast_hash(blob.data(), blob.size(), id);
+  if (m_sim_shares.count(id))
+    return false;
+  const uint64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::system_clock::now().time_since_epoch()).count();
+  // Same clock and same emplace semantics as block receives: re-submissions
+  // and P2P duplicates never move the first-seen timestamp.
+  m_sim_recv.emplace(id, now_ms);
+  for (const auto &kv : m_sim_shares)
+  {
+    if (kv.second.prev_id == bh.prev_id && kv.second.seq == bh.minor_version)
+    {
+      MINFO("SIM-SoP: share slot taken " << id << " prev " << bh.prev_id << " slot " << (uint64_t)bh.minor_version << " (seen, not pooled)");
+      return false;
+    }
+  }
+  const bool on_tip = height == get_current_blockchain_height() && bh.prev_id == m_db->top_block_hash();
+  if (extends_tip)
+    *extends_tip = on_tip;
+  if (local || on_tip)
+    m_btc_valid = false;   // a new share for the tip must reach the next template (own or remote, #146)
+  sim_workshare_entry ent;
+  ent.height = height;
+  ent.prev_id = bh.prev_id;
+  ent.recv_ms = now_ms;
+  ent.blob = blob;
+  ent.local = local;
+  ent.seq = bh.minor_version;   // the slot the share was mined under (#146)
+  if (prev_out)
+    *prev_out = bh.prev_id;
+  if (slot_out)
+    *slot_out = ent.seq;
+  m_sim_shares.emplace(id, ent);
+  // Bound the pool by first-seen order (rates are ~w-1 per block per miner;
+  // 1024 covers many heights of multi-miner gossip).
+  if (m_sim_shares.size() > 1024)
+  {
+    auto oldest = m_sim_shares.begin();
+    for (auto it = m_sim_shares.begin(); it != m_sim_shares.end(); ++it)
+      if (it->second.recv_ms < oldest->second.recv_ms)
+        oldest = it;
+    m_sim_shares.erase(oldest);
+  }
+  return true;
+}
+//------------------------------------------------------------------
+// SIMULATION ONLY (2026-10-19): the pooled workshares at min_height or above,
+// on parent prev_id unless it is null_hash, ordered by height, slot and first
+// seen. Backs the sim_get_workshares RPC: a selfish-mining agent reads its
+// bridge's honest shares and hands them to its offline miner with
+// sim_submit_workshare (core::add_workshare_remote), which embeds them by the
+// slot rule like any gossiped share. False when Share-or-Perish is off.
+bool Blockchain::sim_list_workshares(uint64_t min_height, const crypto::hash &prev_id, std::vector<sim_workshare_info> &out)
+{
+  out.clear();
+  if (!m_sim_sop_enabled)
+    return false;
+  CRITICAL_REGION_LOCAL(m_blockchain_lock);
+  for (const auto &sh : m_sim_shares)
+  {
+    if (sh.second.height < min_height || (prev_id != crypto::null_hash && sh.second.prev_id != prev_id))
+      continue;
+    out.push_back({sh.first, sh.second.height, sh.second.prev_id, sh.second.seq, sh.second.recv_ms, sh.second.local, sh.second.blob});
+  }
+  std::sort(out.begin(), out.end(), [](const sim_workshare_info &a, const sim_workshare_info &b) {
+    if (a.height != b.height)
+      return a.height < b.height;
+    if (a.slot != b.slot)
+      return a.slot < b.slot;
+    return a.recv_ms < b.recv_ms;
+  });
+  return true;
+}
+
+// Difficulty at `h` for weight/PoW purposes. Alt-chain blocks may sit above
+// the main-chain tip, where the main DB has no row (the lookup threw
+// "difficulty not in db" and rejected every LONGER alt chain in the SoP v1
+// and ramp-era v2 runs, review F3): such heights take the tip's difficulty
+// (exact under fixed difficulty, an approximation under LWMA).
+difficulty_type Blockchain::sim_block_difficulty_at(uint64_t h) const
+{
+  const uint64_t top = m_db->height() - 1;
+  return m_db->get_block_difficulty(h <= top ? h : top);
+}
+
+// Earliest local receive time of ANY block (main or alt) at `height`.
+uint64_t Blockchain::sim_pop_first_seen(uint64_t height) const
+{
+  uint64_t first = std::numeric_limits<uint64_t>::max();
+  auto main_it = m_sim_recv.find(get_block_id_by_height(height));
+  if (main_it != m_sim_recv.end())
+    first = std::min(first, main_it->second);
+  m_db->for_all_alt_blocks([&](const crypto::hash &alt_id, const alt_block_data_t &data, const cryptonote::blobdata_ref*) {
+      if (data.height == height)
+      {
+        auto it = m_sim_recv.find(alt_id);
+        if (it != m_sim_recv.end())
+          first = std::min(first, it->second);
+      }
+      return true;
+  });
+  return first;
+}
+
+bool Blockchain::sim_pop_in_time(const crypto::hash &id, uint64_t height) const
+{
+  auto it = m_sim_recv.find(id);
+  if (it == m_sim_recv.end())
+    return true;   // receive time unknown (never happens when enabled from init): permissive
+  const uint64_t first = sim_pop_first_seen(height);
+  if (first == std::numeric_limits<uint64_t>::max())
+    return true;   // the only block ever seen at this height
+  return it->second <= first + m_sim_pop_delay_ms;
+}
+
+bool Blockchain::sim_pop_find_uncle(uint64_t parent_height, crypto::hash &uncle_id) const
+{
+  if (parent_height < 1)
+    return false;
+  const crypto::hash parent_prev = get_block_id_by_height(parent_height - 1);
+  bool found = false;
+  m_db->for_all_alt_blocks([&](const crypto::hash &alt_id, const alt_block_data_t &data, const cryptonote::blobdata_ref*) {
+      if (found || data.height != parent_height)
+        return true;
+      cryptonote::blobdata blob;
+      cryptonote::alt_block_data_t d2;
+      if (!m_db->get_alt_block(alt_id, &d2, &blob))
+        return true;
+      cryptonote::block alt_bl;
+      if (!cryptonote::parse_and_validate_block_from_blob(blob, alt_bl))
+        return true;
+      if (alt_bl.prev_id != parent_prev)
+        return true;
+      if (!sim_pop_in_time(alt_id, parent_height))
+        return true;
+      uncle_id = alt_id;
+      found = true;
+      return true;
+  });
+  return found;
+}
+
+uint64_t Blockchain::sim_pop_uncle_bonus(const block &b, uint64_t height) const
+{
+  if (height < 2)
+    return 0;
+  std::vector<tx_extra_field> fields;
+  if (!parse_tx_extra(b.miner_tx.extra, fields))
+    return 0;
+  crypto::hash parent_prev;
+  if (!sim_pop_parent_prev(b, height, parent_prev))
+    return 0;
+  static constexpr size_t MAGIC_LEN = sizeof(SIM_POP_UNCLE_MAGIC) - 1;
+  uint64_t bonus = 0;
+  for (const auto &f : fields)
+  {
+    if (f.which() != 2)
+      continue;
+    const std::string &nonce = boost::get<tx_extra_nonce>(f).nonce;
+    const size_t pos = nonce.find(SIM_POP_UNCLE_MAGIC, 0, MAGIC_LEN);
+    if (pos == std::string::npos || pos + MAGIC_LEN + sizeof(crypto::hash) > nonce.size())
+      continue;
+    crypto::hash uncle_id;
+    memcpy(&uncle_id, nonce.data() + pos + MAGIC_LEN, sizeof(crypto::hash));
+    if (m_sim_recv.find(uncle_id) == m_sim_recv.end())
+      continue;
+    if (!sim_pop_in_time(uncle_id, height - 1))
+      continue;
+    cryptonote::alt_block_data_t data;
+    cryptonote::blobdata blob;
+    if (!m_db->get_alt_block(uncle_id, &data, &blob) || data.height != height - 1)
+      continue;
+    // Sibling of the containing block's parent (same prev). The template side
+    // (sim_pop_find_uncle) always picked a sibling, but the verifier never
+    // checked, so any locally-held alt block at height-1 -- another fork's
+    // block -- earned the bonus (2026-09-26 patch review, finding 5).
+    cryptonote::block uncle_bl;
+    if (!cryptonote::parse_and_validate_block_from_blob(blob, uncle_bl) || uncle_bl.prev_id != parent_prev)
+      continue;
+    ++bonus;
+  }
+  return bonus;
+}
+
+// The PoP reorg decision, replacing the raw cumulative-difficulty comparison
+// for the alt block that just arrived (alt_chain already contains `bei`).
+// --- MRL #146 share records ----------------------------------------------
+// One embedded workshare: varint seq, varint timestamp, 4B nonce (LE),
+// 32B tx_tree_hash, varint num_transactions. version_major/prev_id/
+// version_minor come from the containing block (version_minor == the
+// share's slot). Each share records the tree hash it was MINED under, so
+// shares verify independently of the block's final coinbase.
+template<typename T>
+static void sim_sop_append_varint(T &out, uint64_t v)
+{
+  for (;;)
+  {
+    uint8_t byte = v & 0x7f;
+    v >>= 7;
+    if (v)
+      byte |= 0x80;
+    out.push_back(byte);
+    if (!v)
+      return;
+  }
+}
+
+static bool sim_sop_read_varint(const std::string &in, size_t &pos, uint64_t &v)
+{
+  v = 0; uint64_t shift = 0;
+  while (pos < in.size())
+  {
+    const uint8_t byte = (uint8_t)in[pos++];
+    v |= (uint64_t)(byte & 0x7f) << shift;
+    shift += 7;
+    if (!(byte & 0x80))
+      return true;
+  }
+  return false;
+}
+
+static blobdata sim_sop_share_record(uint64_t seq, const block_header &bh,
+                                     const std::string &tree_hash, uint64_t num_tx)
+{
+  blobdata rec;
+  sim_sop_append_varint(rec, seq);
+  sim_sop_append_varint(rec, bh.timestamp);
+  const uint8_t *nonce_bytes = reinterpret_cast<const uint8_t*>(&bh.nonce);
+  for (size_t i = 0; i < sizeof(bh.nonce); ++i)   // little-endian, host is LE
+    rec.push_back(nonce_bytes[i]);
+  rec.insert(rec.end(), tree_hash.begin(), tree_hash.end());
+  sim_sop_append_varint(rec, num_tx);
+  return rec;
+}
+
+static bool sim_sop_parse_share_record(const std::string &rec, uint64_t &seq,
+                                       block_header &bh, std::string &tree_hash,
+                                       uint64_t &num_tx)
+{
+  size_t pos = 0;
+  if (!sim_sop_read_varint(rec, pos, seq))
+    return false;
+  if (!sim_sop_read_varint(rec, pos, bh.timestamp))
+    return false;
+  if (pos + sizeof(uint32_t) + 32 > rec.size())
+    return false;
+  memcpy(&bh.nonce, rec.data() + pos, sizeof(uint32_t));
+  pos += sizeof(uint32_t);
+  tree_hash.assign(rec, pos, 32);
+  pos += 32;
+  if (!sim_sop_read_varint(rec, pos, num_tx))
+    return false;
+  return pos == rec.size();
+}
+
+// SIMULATION ONLY (Share-or-Perish): one embedded share record is genuine —
+// it parses, sits at slot `seq`, and its PoW meets diff/w at this height
+// (header rebuilt from the block's major_version/prev_id plus the share's own
+// slot/timestamp/nonce/tree/num_tx). On success `share_blob` is the share's
+// PoW blob, whose fast hash is the id the pool stamped.
+bool Blockchain::sim_sop_check_embedded_share(uint64_t height, const cryptonote::block &bl,
+                                              difficulty_type diff, const std::string &rec,
+                                              uint64_t seq, blobdata &share_blob)
+{
+  uint64_t rec_seq = 0, num_tx = 0;
+  block_header sh;
+  blobdata tree;
+  if (!sim_sop_parse_share_record(rec, rec_seq, sh, tree, num_tx) || rec_seq != seq)
+    return false;
+  sh.major_version = bl.major_version;
+  sh.minor_version = seq;             // the slot the share was mined under (#146)
+  sh.prev_id = bl.prev_id;
+  blobdata hb;
+  if (!::serialization::dump_binary(sh, hb))
+    return false;
+  // The share's ORIGINAL PoW blob: its header, the tree hash it was mined
+  // under, its tx count. Hash THIS blob (blobdata overload). Rebuilding a
+  // block and hashing that recomputes the tree hash from an empty coinbase
+  // (and appends the wrong count), so no share ever verified at real
+  // difficulty before 2026-09-25 (review F2).
+  share_blob = hb;
+  share_blob.insert(share_blob.end(), tree.begin(), tree.end());
+  sim_sop_append_varint(share_blob, num_tx);
+  const difficulty_type share_target = diff / m_sim_sop_w ? diff / m_sim_sop_w : 1;
+  crypto::hash pow;
+  return get_block_longhash(this, share_blob, pow, height, bl.major_version, nullptr, 0)
+      && check_hash(pow, share_target);
+}
+
+// SIMULATION ONLY (MRL #146 2026-10-20): a pooled share's PoW, the full PoW
+// blob as gossiped, against diff/w at `height`.
+bool Blockchain::sim_sop_pool_share_pow_ok(const blobdata &blob, uint64_t height, uint8_t major, difficulty_type diff)
+{
+  const difficulty_type target = diff / m_sim_sop_w ? diff / m_sim_sop_w : 1;
+  crypto::hash pow;
+  return get_block_longhash(this, blob, pow, height, major, nullptr, 0) && check_hash(pow, target);
+}
+
+// SIMULATION ONLY (MRL #146 2026-10-20, conformance convention 11): pool
+// shares that extend `tip_id` at height tip_height+1 and pass PoW; first seen
+// per slot; the contiguous run of slots from `major` counts. Appends the
+// pool entries to `js` as [{"id","slot","seen","pow_ok"}].
+uint64_t Blockchain::sim_sop_tip_shares(const crypto::hash &tip_id, uint64_t tip_height, uint8_t major,
+                                        difficulty_type diff, std::ostringstream *js)
+{
+  std::map<uint64_t, uint64_t> first_seen;   // slot -> earliest recv of a PoW-valid share
+  bool any = false;
+  if (js)
+    *js << "[";
+  for (const auto &sh : m_sim_shares)
+  {
+    if (sh.second.prev_id != tip_id || sh.second.height != tip_height + 1)
+      continue;
+    // RandomX per share per decision is costly: cache by share id (a share's
+    // height, and so its difficulty, is fixed by its parent).
+    auto pit = m_sim_sop_pool_pow_ok.find(sh.first);
+    if (pit == m_sim_sop_pool_pow_ok.end())
+    {
+      if (m_sim_sop_pool_pow_ok.size() > 4096)
+        m_sim_sop_pool_pow_ok.clear();
+      pit = m_sim_sop_pool_pow_ok.emplace(sh.first,
+          sim_sop_pool_share_pow_ok(sh.second.blob, sh.second.height, major, diff)).first;
+    }
+    const bool ok = pit->second;
+    if (js)
+      *js << (any ? "," : "") << "{\"id\":\"" << epee::string_tools::pod_to_hex(sh.first)
+          << "\",\"slot\":" << sh.second.seq << ",\"seen\":" << sh.second.recv_ms
+          << ",\"pow_ok\":" << (ok ? "true" : "false") << "}";
+    any = true;
+    if (!ok)
+      continue;
+    auto it = first_seen.find(sh.second.seq);
+    if (it == first_seen.end() || sh.second.recv_ms < it->second)
+      first_seen[sh.second.seq] = sh.second.recv_ms;
+  }
+  if (js)
+    *js << "]";
+  uint64_t n = 0;
+  while (first_seen.count(major + n))
+    ++n;
+  return n;
+}
+
+// SIMULATION ONLY (conformance convention 13): alt tips whose fork point is
+// within 10*w of the main tip (diagnostic for the pairwise comparison).
+uint64_t Blockchain::sim_sop_alt_tips_in_window(uint64_t top)
+{
+  std::unordered_set<crypto::hash> ids, parents;
+  m_db->for_all_alt_blocks([&](const crypto::hash &id, const alt_block_data_t &data, const cryptonote::blobdata_ref *blob) {
+      if (data.height + 10 * m_sim_sop_w > top)
+        ids.insert(id);
+      cryptonote::block b;
+      if (blob && parse_and_validate_block_from_blob(*blob, b))
+        parents.insert(b.prev_id);
+      return true;
+  }, true);
+  uint64_t n = 0;
+  for (const auto &id : ids)
+    if (!parents.count(id))
+      ++n;
+  return n;
+}
+
+// SIMULATION ONLY (Share-or-Perish, MRL #146): the ids of a block's embedded
+// workshares in slot order, when the whole set conforms (slots V..V+N-1,
+// minor_version == V+N with V = major_version, every PoW meets diff/w),
+// else empty. A non-conforming
+// set counts as the header alone, in n_f and in weight
+// (docs/20260930_sop_conformance.md, convention 8). Cached by block id,
+// since a block's difficulty is fixed by its ancestry. Before 2026-09-30 the
+// k*w window counted tag-7 fields unchecked, so junk fields crossed it in
+// one block.
+const std::vector<crypto::hash> &Blockchain::sim_sop_block_shares(uint64_t height, const cryptonote::block &bl, difficulty_type diff)
+{
+  const crypto::hash id = get_block_hash(bl);
+  auto it = m_sim_sop_block_share_ids.find(id);
+  if (it != m_sim_sop_block_share_ids.end())
+    return it->second;
+  std::vector<crypto::hash> ids;
+  std::vector<tx_extra_field> fields;
+  if (parse_tx_extra(bl.miner_tx.extra, fields))
+  {
+    for (const auto &f : fields)
+    {
+      if (f.which() != 7)          // variant: ..., 6 sim_uncle, 7 sim_workshare
+        continue;
+      blobdata share_blob;
+      if (!sim_sop_check_embedded_share(height, bl, diff,
+                                        boost::get<tx_extra_sim_workshare>(f).data,
+                                        bl.major_version + ids.size(), share_blob))
+      { ids.clear(); break; }
+      crypto::hash sid;
+      cn_fast_hash(share_blob.data(), share_blob.size(), sid);
+      ids.push_back(sid);
+    }
+  }
+  if (bl.major_version + ids.size() != bl.minor_version)
+    ids.clear();
+  return m_sim_sop_block_share_ids.emplace(id, std::move(ids)).first->second;
+}
+
+uint64_t Blockchain::sim_sop_valid_share_count(uint64_t height, const cryptonote::block &bl, difficulty_type diff)
+{
+  return sim_sop_block_shares(height, bl, diff).size();
+}
+
+// SIMULATION ONLY (Share-or-Perish, MRL #146 Tables 3-5): one block's weight.
+// A block within the last 10*w blocks of the main tip weighs
+// unit*(l_b + l_b*sum(l_w)), with unit = diff/w. An older block weighs diff,
+// and its shares 0. Outside the subjective regime every lateness factor is 1:
+// the spec's "objective chain weights" still count shares, they are not plain
+// difficulty.
+// main_seen is the first receipt of the MAIN-CHAIN block at this height, or
+// the block's own receipt when the alt chain is ahead. So a main-chain block
+// is never late. A share never gossiped to this node was first seen inside
+// its block. Unknown receive times (grafted snapshot blocks) are permissive.
+// Before 2026-09-30 lateness was measured against the first block seen at the
+// height on ANY chain, and the objective regime compared plain cumulative
+// difficulty. When `js` is set, it receives the block's decision-log entry
+// (docs/20260930_sop_conformance.md).
+difficulty_type Blockchain::sim_sop_weight(uint64_t height, const cryptonote::block &bl, difficulty_type diff,
+                                           bool subjective, bool on_main, std::ostringstream *js)
+{
+  const uint64_t top = m_db->height() - 1;
+  const crypto::hash id = get_block_hash(bl);
+  const auto bit = m_sim_recv.find(id);
+  const bool seen_known = bit != m_sim_recv.end();
+  const int64_t seen = seen_known ? static_cast<int64_t>(bit->second) : 0;
+  const std::vector<crypto::hash> &shares = sim_sop_block_shares(height, bl, diff);
+  const bool old = height + 10 * m_sim_sop_w <= top;
+  if (js)
+  {
+    *js << "{\"h\":" << height << ",\"id\":\"" << epee::string_tools::pod_to_hex(id)
+        << "\",\"diff\":\"" << diff << "\",\"seen\":";
+    if (seen_known)
+      *js << seen;
+    else
+      *js << "null";
+    const auto rit = m_sim_main_seen.find(height);
+    *js << ",\"ref\":";
+    if (rit != m_sim_main_seen.end())
+      *js << rit->second;
+    else
+      *js << "null";
+    *js << ",\"n_sh\":" << shares.size();
+    if (!old && !shares.empty())
+    {
+      *js << ",\"shares\":[";
+      for (size_t i = 0; i < shares.size(); ++i)
+      {
+        const auto sit = m_sim_recv.find(shares[i]);
+        *js << (i ? "," : "") << "{\"id\":\"" << epee::string_tools::pod_to_hex(shares[i]) << "\",\"seen\":";
+        if (sit != m_sim_recv.end())
+          *js << sit->second;
+        else
+          *js << "null";
+        *js << "}";
+      }
+      *js << "]";
+    }
+    *js << "}";
+  }
+  if (old)
+    return diff;                       // legacy window: shares weigh 0
+  difficulty_type unit = diff / m_sim_sop_w;
+  if (unit == 0)
+    unit = 1;   // sim-only floor: bootstrap difficulties < w would zero every
+                // block (real Monero never sees diff < w)
+
+  // main_seen (#146 revised 2026-10-15): when the first block of this height
+  // to join this node's main chain was seen, recorded at that moment and
+  // never changed by later switches; the same reference on both chains, so
+  // a chain's weight no longer depends on which chain the node is on. No
+  // such block (alt ahead, or heights loaded from disk): main_seen =
+  // block_seen. Before this, main_seen was the CURRENT main block at the
+  // height, so it moved with every switch.
+  (void)on_main;
+  bool main_known = seen_known;
+  int64_t main_seen = seen;
+  const auto mit = m_sim_main_seen.find(height);
+  if (mit != m_sim_main_seen.end())
+  {
+    main_known = true;
+    main_seen = static_cast<int64_t>(mit->second);
+  }
+  const int64_t d = static_cast<int64_t>(m_sim_sop_delay_ms);
+  // l_b multiplies EVERY term (MRL #146 Table 3): a late block weighs zero
+  // however many of its shares were gossiped early.
+  if (subjective && seen_known && main_known && seen - main_seen > d)
+    return 0;
+  difficulty_type wgt = unit;
+  for (const auto &sid : shares)
+  {
+    bool lw = true;
+    if (subjective)
+    {
+      const auto sit = m_sim_recv.find(sid);
+      const bool share_known = sit != m_sim_recv.end() || seen_known;
+      const int64_t share_seen = sit != m_sim_recv.end() ? static_cast<int64_t>(sit->second) : seen;
+      if (main_known && share_known && main_seen - share_seen <= d)
+        lw = false;                    // not seen more than d before the main block (Table 5)
+    }
+    if (lw)
+      wgt += unit;
+  }
+  return wgt;
+}
+
+// SIMULATION ONLY (Share-or-Perish): the #146 fork choice over the divergent
+// suffixes (docs/20260930_sop_conformance.md).
+// - The regime is subjective iff this node came online before the fork (h0
+//   below the last common block, #146's h_f) and both branches hold fewer
+//   than k*w work objects past it (the revised n_f). Otherwise, and before
+//   the node comes online, every lateness factor is 1 and the
+//   share-counted weights still decide.
+// - Displaced blocks re-inserted by a reorg are stored without judging
+//   (whole-branch comparison), unless --sim-sop-rejudge-displaced is set.
+// - Exact ties get one random draw per (alt tip, main tip) pair.
+// - Every evaluation logs its inputs and result as a SIM-SoP-DEC line for
+//   scripts/sop_oracle.py.
+bool Blockchain::sim_sop_should_switch(const std::list<block_extended_info> &alt_chain, const block_extended_info &bei)
+{
+  const uint64_t top = m_db->height() - 1;
+  const uint64_t hf = alt_chain.front().height;       // first alt block (#146 h_f, convention 3)
+  const uint64_t fork = hf - 1;
+  const uint64_t alt_len = alt_chain.size();
+  const uint64_t main_len = top > fork ? top - fork : 0;
+  const bool reinsert = m_sim_sop_reinsert_depth > 0;
+  const bool skip = reinsert && !m_sim_sop_rejudge;
+
+  // Alt-block difficulties come from the alt chain's own cumulative deltas
+  // (no main-DB row exists above the tip, review F3).
+  const difficulty_type fork_cum = m_db->get_block_cumulative_difficulty(fork);
+  std::vector<difficulty_type> alt_diff;
+  alt_diff.reserve(alt_len);
+  uint64_t nf = 0;
+  {
+    difficulty_type prev_cum = fork_cum;
+    for (const auto &e : alt_chain)
+    {
+      const difficulty_type d = e.cumulative_difficulty > prev_cum ? e.cumulative_difficulty - prev_cum : 0;
+      prev_cum = e.cumulative_difficulty;
+      alt_diff.push_back(d);
+      nf += 1 + sim_sop_valid_share_count(e.height, e.bl, d);
+    }
+  }
+  // Work objects on the main side of the fork, counted the same way
+  // (n_main(h_f)); with nf it decides the regime.
+  uint64_t nf_main = 0;
+  for (uint64_t h = fork + 1; h <= top; ++h)
+  {
+    cryptonote::block main_bl;
+    if (get_block_by_hash(get_block_id_by_height(h), main_bl))
+      nf_main += 1 + sim_sop_valid_share_count(h, main_bl, m_db->get_block_difficulty(h));
+  }
+  // #146 (2026-10-16 22:07): n_max counts each branch's work objects above
+  // h_f+1, so the first block after the fork (patch hf) is not counted;
+  // pool shares are not counted either.
+  uint64_t n_alt = 0, n_main = 0;
+  {
+    bool first_alt = true;
+    size_t j = 0;
+    for (const auto &e : alt_chain)
+    {
+      const uint64_t n = 1 + sim_sop_valid_share_count(e.height, e.bl, alt_diff[j++]);
+      if (!first_alt)
+        n_alt += n;
+      first_alt = false;
+    }
+    for (uint64_t h = hf + 1; h <= top; ++h)
+    {
+      cryptonote::block main_bl;
+      if (get_block_by_hash(get_block_id_by_height(h), main_bl))
+        n_main += 1 + sim_sop_valid_share_count(h, main_bl, m_db->get_block_difficulty(h));
+    }
+  }
+  const uint64_t window = m_sim_sop_k > 0 ? (m_sim_sop_k - 1) * m_sim_sop_w : 0;
+  const uint64_t h_max = std::max(top, alt_chain.back().height);
+  const bool nakamoto = h_max - fork >= 10 * m_sim_sop_w;
+  // The difficulty gate is sim-only (convention 9): at fakechain bootstrap
+  // difficulty (< w) every weight collapses to the unit floor and forks
+  // degenerate into per-node random ties. Real Monero never sees diff < w.
+  // #146's h_f is the last common block, hf - 1 here (hf = first alt block).
+  // Before the node comes online its receive times are download times, not
+  // live observation: objective.
+  const bool subjective = !nakamoto && m_sim_sop_online && m_sim_sop_h0 + 1 < hf
+      && std::max(n_alt, n_main) < window && alt_diff.front() >= m_sim_sop_w;
+
+  std::ostringstream alt_js, main_js;
+  difficulty_type w_alt = 0, w_main = 0;
+  alt_js << "[";
+  size_t i = 0;
+  for (const auto &e : alt_chain)
+  {
+    if (i)
+      alt_js << ",";
+    const difficulty_type wa = sim_sop_weight(e.height, e.bl, alt_diff[i], subjective, false, &alt_js);
+    w_alt += nakamoto ? alt_diff[i] : wa;   // nakamoto: header difficulty only (Table 3)
+    ++i;
+  }
+  alt_js << "]";
+  main_js << "[";
+  bool first = true;
+  for (uint64_t h = fork + 1; h <= top; ++h)
+  {
+    cryptonote::block main_bl;
+    if (!get_block_by_hash(get_block_id_by_height(h), main_bl))
+      continue;
+    if (!first)
+      main_js << ",";
+    first = false;
+    const difficulty_type dh = m_db->get_block_difficulty(h);
+    const difficulty_type wm = sim_sop_weight(h, main_bl, dh, subjective, true, &main_js);
+    w_main += nakamoto ? dh : wm;
+  }
+  main_js << "]";
+
+  // Pool shares on each chain's tip (MRL #146 2026-10-20); always logged,
+  // counted only in the objective regime.
+  const crypto::hash alt_tip = get_block_hash(alt_chain.back().bl);
+  const crypto::hash main_tip = get_block_id_by_height(top);
+  const uint8_t major = alt_chain.back().bl.major_version;
+  const difficulty_type pool_diff_alt = alt_diff.back();
+  const difficulty_type pool_diff_main = m_db->get_block_difficulty(top);
+  std::ostringstream pool_alt_js, pool_main_js;
+  const uint64_t pool_alt = sim_sop_tip_shares(alt_tip, alt_chain.back().height, major, pool_diff_alt, &pool_alt_js);
+  const uint64_t pool_main = sim_sop_tip_shares(main_tip, top, major, pool_diff_main, &pool_main_js);
+  uint64_t pool_alt_counted = 0, pool_main_counted = 0;
+  if (!nakamoto && !subjective)
+  {
+    pool_alt_counted = pool_alt;
+    pool_main_counted = pool_main;
+    const difficulty_type ua = pool_diff_alt / m_sim_sop_w ? pool_diff_alt / m_sim_sop_w : 1;
+    const difficulty_type um = pool_diff_main / m_sim_sop_w ? pool_diff_main / m_sim_sop_w : 1;
+    w_alt += ua * pool_alt;
+    w_main += um * pool_main;
+  }
+
+  const bool tie = w_alt == w_main;
+  bool sw = false;
+  const char *tie_draw = nullptr;
+  if (!skip && !tie)
+    sw = w_alt > w_main;
+  else if (!skip)
+  {
+    // "If a node sees two chains of the exact same weight, it makes a random
+    // selection" -- once. Re-judging the same pair must not re-roll it.
+    const auto key = std::make_pair(get_block_hash(bei.bl), get_block_id_by_height(top));
+    const auto it = m_sim_sop_tie_draws.find(key);
+    if (it != m_sim_sop_tie_draws.end())
+    {
+      sw = it->second;
+      tie_draw = "cached";
+    }
+    else
+    {
+      sw = m_sim_pop_det_tie
+        ? bool(get_block_hash(bei.bl) < get_block_id_by_height(top))
+        : bool(m_sim_pop_rng() & 1);
+      tie_draw = m_sim_pop_det_tie ? "det" : "random";
+      if (m_sim_sop_tie_draws.size() > 4096)
+        m_sim_sop_tie_draws.clear();
+      m_sim_sop_tie_draws.emplace(key, sw);
+    }
+  }
+  const char *res = sw ? "SWITCH" : "KEEP";
+  if (!subjective)
+    MINFO("SIM-SoP: fork " << fork << " OBJECTIVE alt " << w_alt << "/" << alt_len
+          << " vs main " << w_main << "/" << main_len
+          << " (h0=" << m_sim_sop_h0 << " nf=" << nf << " nf_main=" << nf_main
+          << " n_alt=" << n_alt << " n_main=" << n_main << (nakamoto ? " nakamoto" : "")
+          << " pool=" << pool_alt_counted << "/" << pool_main_counted << ") -> " << res
+          << (tie_draw ? std::string(" (") + tie_draw + " tie)" : std::string())
+          << (skip ? " (reinsert, skipped)" : ""));
+  else if (!tie_draw)
+    MINFO("SIM-SoP: fork " << fork << " alt " << w_alt << "/" << alt_len
+          << " vs main " << w_main << "/" << main_len
+          << " (n_alt=" << n_alt << " n_main=" << n_main << ") -> " << res
+          << (skip ? " (reinsert, skipped)" : ""));
+  else
+    MINFO("SIM-SoP: fork " << fork << " TIE " << w_alt << "/" << alt_len
+          << " vs " << w_main << "/" << main_len
+          << " -> " << res << " (" << tie_draw << " tie)");
+
+  std::ostringstream js;
+  js << "{\"v\":4,\"mode\":\"" << (m_sim_sop_rejudge ? "rejudge" : "whole_branch")
+     << "\",\"reinsert\":" << (reinsert ? "true" : "false")
+     << ",\"skipped\":" << (skip ? "true" : "false")
+     << ",\"h0\":" << m_sim_sop_h0 << ",\"online\":" << (m_sim_sop_online ? "true" : "false")
+     << ",\"hf\":" << hf << ",\"top\":" << top
+     << ",\"w\":" << m_sim_sop_w << ",\"k\":" << m_sim_sop_k << ",\"d_ms\":" << m_sim_sop_delay_ms
+     << ",\"alt\":" << alt_js.str() << ",\"main\":" << main_js.str()
+     << ",\"nf\":" << nf << ",\"nf_main\":" << nf_main
+     << ",\"nf_rule\":\"either\""
+     << ",\"n_alt\":" << n_alt << ",\"n_main\":" << n_main
+     << ",\"nakamoto\":" << (nakamoto ? "true" : "false") << ",\"major\":" << unsigned(major)
+     << ",\"alt_tip\":\"" << epee::string_tools::pod_to_hex(alt_tip)
+     << "\",\"main_tip\":\"" << epee::string_tools::pod_to_hex(main_tip)
+     << "\",\"pool_alt\":" << pool_alt_js.str() << ",\"pool_main\":" << pool_main_js.str()
+     << ",\"pool_diff_alt\":\"" << pool_diff_alt << "\",\"pool_diff_main\":\"" << pool_diff_main
+     << "\",\"pool_alt_counted\":" << pool_alt_counted << ",\"pool_main_counted\":" << pool_main_counted
+     << ",\"alt_tips\":" << sim_sop_alt_tips_in_window(top)
+     << ",\"regime\":\"" << (nakamoto ? "nakamoto" : (subjective ? "subjective" : "objective"))
+     << "\",\"w_alt\":\"" << w_alt << "\",\"w_main\":\"" << w_main
+     << "\",\"tie\":" << (tie ? "true" : "false") << ",\"tie_draw\":";
+  if (tie_draw)
+    js << "\"" << tie_draw << "\"";
+  else
+    js << "null";
+  js << ",\"result\":\"" << res << "\"}";
+  MINFO("SIM-SoP-DEC " << js.str());
+  return sw;
+}
+
+void Blockchain::set_sim_sop(uint64_t w, uint64_t delay_ms, uint64_t k, bool rejudge_displaced)
+{
+  m_sim_sop_rejudge = rejudge_displaced;
+  m_sim_sop_w = w > 1 ? w : 2;
+  m_sim_sop_delay_ms = delay_ms;
+  m_sim_sop_k = k;
+  m_sim_sop_enabled = true;
+  m_sim_pop_enabled = true;   // arms the receive-time ledger (l_b/l_w clock)
+  m_sim_pop_rng.seed(std::random_device{}());   // random tie-break (was default-seeded when SoP ran without --sim-publish-or-perish)
+  m_sim_sop_h0 = get_current_blockchain_height() > 1 ? get_current_blockchain_height() - 1 : 0;   // #146 h_0 starts at the DB tip (see sim_sop_on_synchronized)
+  MINFO("SIM-SoP: weight table armed (w=" << m_sim_sop_w
+        << " delay_ms=" << delay_ms << " k=" << k << " mode="
+        << (m_sim_sop_rejudge ? "rejudge" : "whole_branch") << ")");
+}
+
+// SIMULATION ONLY (Share-or-Perish): #146 h_0, "the block height when the
+// node came online", is the node's tip once it has caught up and follows the
+// network live. The node comes online when monerod first counts it as
+// synchronized, which it must be before it mines: at its first sync ("You
+// are now synchronized with the network"), with h0 its tip then, so a node
+// that starts behind the network gets the height it caught up to. An
+// --offline node (the attacker's private miner) counts as synchronized from
+// startup and never syncs: h0 is its DB tip. Until it comes online the node
+// judges every fork objectively. h0 is set once.
+void Blockchain::sim_sop_on_synchronized(bool offline)
+{
+  CRITICAL_REGION_LOCAL(m_blockchain_lock);
+  if (!m_sim_sop_enabled || m_sim_sop_online)
+    return;
+  m_sim_sop_online = true;
+  const uint64_t db_tip = m_sim_sop_h0;
+  const uint64_t height = get_current_blockchain_height();
+  m_sim_sop_h0 = std::max(db_tip, height > 1 ? height - 1 : 0);
+  MINFO("SIM-SoP: online, h0=" << m_sim_sop_h0 << " ("
+        << (offline ? "--offline: synchronized at startup" : "first sync") << ", DB tip " << db_tip << ")");
+}
