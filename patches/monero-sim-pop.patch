+
+// SIMULATION ONLY (Share-or-Perish, MRL #146): the workshare notify must
+// round-trip byte-exactly (embedded-NUL blob + height).
+TEST(protocol_pack, workshare_round_trip)
+{
+  epee::byte_slice buff;
+  cryptonote::NOTIFY_NEW_WORKSHARE::request r;
+  r.blob = std::string(80, static_cast<char>(0x5a));
+  r.height = 42;
+  ASSERT_TRUE(epee::serialization::store_t_to_binary(r, buff));
+
+  cryptonote::NOTIFY_NEW_WORKSHARE::request r2;
+  ASSERT_TRUE(epee::serialization::load_t_from_binary(r2, epee::to_span(buff)));
+  ASSERT_TRUE(r2.blob.size() == 80);
+  ASSERT_TRUE(r2.blob == r.blob);
+  ASSERT_TRUE(r2.height == 42);
+}
