+
+// --- MRL #144 EXACT uncle machinery -------------------------------------
+// Template side: the hashing blob (PoW header) of one in-time alt block
+// that competed with the block we are about to build on (height N-1
+// sibling, same prev).
+bool Blockchain::sim_pop_find_uncle_header(uint64_t parent_height, blobdata &header_blob) const
+{
+  if (parent_height < 1)
+    return false;
+  const crypto::hash parent_prev = get_block_id_by_height(parent_height - 1);
+  bool found = false;
+  m_db->for_all_alt_blocks([&](const crypto::hash &alt_id, const alt_block_data_t &data, const cryptonote::blobdata_ref*) {
+      if (found || data.height != parent_height)
+        return true;
+      cryptonote::blobdata blob;
+      cryptonote::alt_block_data_t d2;
+      if (!m_db->get_alt_block(alt_id, &d2, &blob))
+        return true;
+      cryptonote::block alt_bl;
+      if (!cryptonote::parse_and_validate_block_from_blob(blob, alt_bl))
+        return true;
+      if (alt_bl.prev_id != parent_prev)
+        return true;
+      if (!sim_pop_in_time(alt_id, parent_height))
+        return true;
+      header_blob = get_block_hashing_blob(alt_bl);
+      found = true;
+      return true;
+  });
+  return found;
+}
+
+// Weight side (trustless per MRL #144): an embedded header counts when its
+// PoW meets the difficulty at the uncle height and its prev_id makes it a
+// sibling of the containing block's parent. In-time-ness: a block we
+// RECEIVED is held to the lateness rule; one we never received still
+// counts — that self-contained verifiability is the point of the 80-byte
+// header form (the DEVIATED id-in-nonce variant cannot do this).
+uint64_t Blockchain::sim_pop_uncle_bonus_header(const block &b, uint64_t height) const
+{
+  if (height < 2)
+    return 0;
+  std::vector<tx_extra_field> fields;
+  if (!parse_tx_extra(b.miner_tx.extra, fields))
+    return 0;
+  const crypto::hash parent_prev = get_block_id_by_height(height - 2);
+  uint64_t bonus = 0;
+  for (const auto &f : fields)
+  {
+    if (f.which() != 6)          // variant: ..., 5 minergate, 6 sim_uncle
+      continue;
+    const std::string &blob = boost::get<tx_extra_sim_uncle>(f).data;
+
+    // Re-derive the uncle id; re-parse the header; the trailing varint
+    // must consume the rest exactly, and a reconstructed block must
+    // reproduce the blob byte-for-byte or the header counts for nothing.
+    crypto::hash uncle_id;
+    cn_fast_hash(blob.data(), blob.size(), uncle_id);
+    std::vector<uint8_t> v(blob.begin(), blob.end());
+    binary_archive<false> ar{epee::to_span(v)};
+    block_header bh;
+    if (!::do_serialize(ar, bh))
+      continue;
+    blobdata hb;
+    if (!::serialization::dump_binary(bh, hb))
+      continue;
+    if (hb.empty() || hb.size() >= v.size())
+      continue;
+    uint64_t tx_count = 0;
+    {
+      size_t pos = hb.size(); uint64_t shift = 0;
+      bool done = false;
+      while (pos < v.size())
+      {
+        const uint8_t byte = v[pos++];
+        tx_count |= (uint64_t)(byte & 0x7f) << shift;
+        shift += 7;
+        if (!(byte & 0x80)) { done = true; break; }
+      }
+      if (!done || pos != v.size())
+        continue;               // trailing junk / multi-field tail
+    }
+    block ub;
+    ub.major_version = bh.major_version;
+    ub.minor_version = bh.minor_version;
+    ub.timestamp = bh.timestamp;
+    ub.prev_id = bh.prev_id;
+    ub.nonce = bh.nonce;
+    ub.tx_hashes.resize(tx_count);
+    if (get_block_hashing_blob(ub) != blob)
+      continue;                 // non-canonical encoding
+    if (bh.prev_id != parent_prev)
+      continue;                 // not a sibling of our parent (MRL #144 height check)
+
+    // PoW: the header must meet the difficulty at the uncle height.
+    crypto::hash pow;
+    get_block_longhash(this, ub, pow, height - 1, 0);
+    if (!check_hash(pow, m_db->get_block_difficulty(height - 1)))
+      continue;
+
+    // Lateness: received uncles are held to Def.1; never-received ones
+    // count (trustless — the PoW above is their proof of reality).
+    auto it = m_sim_recv.find(uncle_id);
+    if (it != m_sim_recv.end() && !sim_pop_in_time(uncle_id, height - 1))
+      continue;
+    ++bonus;
+  }
+  return bonus;
+}
+
+// Earliest local receive time of ANY block (main or alt) at `height`.
+uint64_t Blockchain::sim_pop_first_seen(uint64_t height) const
+{
+  uint64_t first = std::numeric_limits<uint64_t>::max();
+  auto main_it = m_sim_recv.find(get_block_id_by_height(height));
+  if (main_it != m_sim_recv.end())
+    first = std::min(first, main_it->second);
+  m_db->for_all_alt_blocks([&](const crypto::hash &alt_id, const alt_block_data_t &data, const cryptonote::blobdata_ref*) {
+      if (data.height == height)
+      {
+        auto it = m_sim_recv.find(alt_id);
+        if (it != m_sim_recv.end())
+          first = std::min(first, it->second);
+      }
+      return true;
+  });
+  return first;
+}
+
+bool Blockchain::sim_pop_in_time(const crypto::hash &id, uint64_t height) const
+{
+  auto it = m_sim_recv.find(id);
+  if (it == m_sim_recv.end())
+    return true;   // receive time unknown (never happens when enabled from init): permissive
+  const uint64_t first = sim_pop_first_seen(height);
+  if (first == std::numeric_limits<uint64_t>::max())
+    return true;   // the only block ever seen at this height
+  return it->second <= first + m_sim_pop_delay_ms;
+}
+
+bool Blockchain::sim_pop_find_uncle(uint64_t parent_height, crypto::hash &uncle_id) const
+{
+  if (parent_height < 1)
+    return false;
+  const crypto::hash parent_prev = get_block_id_by_height(parent_height - 1);
+  bool found = false;
+  m_db->for_all_alt_blocks([&](const crypto::hash &alt_id, const alt_block_data_t &data, const cryptonote::blobdata_ref*) {
+      if (found || data.height != parent_height)
+        return true;
+      cryptonote::blobdata blob;
+      cryptonote::alt_block_data_t d2;
+      if (!m_db->get_alt_block(alt_id, &d2, &blob))
+        return true;
+      cryptonote::block alt_bl;
+      if (!cryptonote::parse_and_validate_block_from_blob(blob, alt_bl))
+        return true;
+      if (alt_bl.prev_id != parent_prev)
+        return true;
+      if (!sim_pop_in_time(alt_id, parent_height))
+        return true;
+      uncle_id = alt_id;
+      found = true;
+      return true;
+  });
+  return found;
+}
+
+uint64_t Blockchain::sim_pop_uncle_bonus(const block &b, uint64_t height) const
+{
+  std::vector<tx_extra_field> fields;
+  if (!parse_tx_extra(b.miner_tx.extra, fields))
+    return 0;
+  static constexpr size_t MAGIC_LEN = sizeof(SIM_POP_UNCLE_MAGIC) - 1;
+  uint64_t bonus = 0;
+  for (const auto &f : fields)
+  {
+    if (f.which() != 2)
+      continue;
+    const std::string &nonce = boost::get<tx_extra_nonce>(f).nonce;
+    const size_t pos = nonce.find(SIM_POP_UNCLE_MAGIC, 0, MAGIC_LEN);
+    if (pos == std::string::npos || pos + MAGIC_LEN + sizeof(crypto::hash) > nonce.size())
+      continue;
+    crypto::hash uncle_id;
+    memcpy(&uncle_id, nonce.data() + pos + MAGIC_LEN, sizeof(crypto::hash));
+    if (m_sim_recv.find(uncle_id) == m_sim_recv.end())
+      continue;
+    if (!sim_pop_in_time(uncle_id, height - 1))
+      continue;
+    cryptonote::alt_block_data_t data;
+    cryptonote::blobdata blob;
+    if (!m_db->get_alt_block(uncle_id, &data, &blob) || data.height != height - 1)
+      continue;
+    ++bonus;
+  }
+  return bonus;
+}
