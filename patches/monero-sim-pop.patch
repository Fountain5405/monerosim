+// 2026-09-24.) Shared by the uncle-header verifier and the SoP workshare
+// pool.
+static bool sim_parse_pow_header(const std::string &blob, block_header &bh, uint64_t &tx_count)
+{
+  std::vector<uint8_t> v(blob.begin(), blob.end());
+  binary_archive<false> ar{epee::to_span(v)};
+  if (!::do_serialize(ar, bh))
+    return false;
+  blobdata hb;
+  if (!::serialization::dump_binary(bh, hb))
+    return false;
+  if (hb.empty() || hb.size() + 32 >= v.size())
+    return false;
+  tx_count = 0;
+  {
+    size_t pos = hb.size() + 32; uint64_t shift = 0;   // skip the tx-tree hash
+    bool terminated = false;
+    while (pos < v.size())
+    {
+      const uint8_t byte = v[pos++];
+      tx_count |= (uint64_t)(byte & 0x7f) << shift;
+      shift += 7;
+      if (!(byte & 0x80)) { terminated = true; break; }
+    }
+    if (!terminated || pos != v.size())
+      return false;           // trailing junk / unterminated varint
+  }
+  return true;
+}
+
+// Weight side (trustless per MRL #144): an embedded header counts when its
+// PoW meets the difficulty at the uncle height and its prev_id makes it a
+// sibling of the containing block's parent. In-time-ness: a block we
+// RECEIVED is held to the lateness rule; one we never received still
+// counts — that self-contained verifiability is the point of the 80-byte
+// header form (the DEVIATED id-in-nonce variant cannot do this).
+uint64_t Blockchain::sim_pop_uncle_bonus_header(const block &b, uint64_t height) const
+{
+  if (height < 2)
+    return 0;
+  std::vector<tx_extra_field> fields;
+  if (!parse_tx_extra(b.miner_tx.extra, fields))
+    return 0;
+  const crypto::hash parent_prev = get_block_id_by_height(height - 2);
+  uint64_t bonus = 0;
+  for (const auto &f : fields)
+  {
+    if (f.which() != 6)          // variant: ..., 5 minergate, 6 sim_uncle
+      continue;
+    const std::string &blob = boost::get<tx_extra_sim_uncle>(f).data;
+
+    // Re-derive the uncle id; re-parse the header (canonical form only);
+    // a reconstructed block must reproduce the blob byte-for-byte or the
+    // header counts for nothing.
+    crypto::hash uncle_id;
+    {
+      // The uncle's block id = keccak(varint(size) || hashing blob), exactly
+      // what calculate_block_hash computes (get_object_hash serializes the
+      // blob as a length-prefixed string). A bare keccak of the blob is NOT
+      // the block id, so the lateness lookup below never matched before.
+      blobdata pre;
+      sim_sop_append_varint(pre, blob.size());
+      pre += blob;
+      get_blob_hash(pre, uncle_id);
+    }
+    block_header bh;
+    uint64_t tx_count = 0;
+    if (!sim_parse_pow_header(blob, bh, tx_count))   // canonical header + tree hash + exact-fit count
+      continue;
+    (void)tx_count;
+    if (bh.prev_id != parent_prev)
+      continue;                 // not a sibling of our parent (MRL #144 height check)
+
+    // PoW: hash the embedded blob ITSELF (blobdata overload). Rebuilding a
+    // block from the header and hashing that recomputes the tree hash from
+    // an empty coinbase (and a wrong tx count), so it can never reproduce
+    // the mined blob -- the comparison that kept this bonus inert in every
+    // run through 2026-09-25 (review F4).
+    crypto::hash pow;
+    if (!get_block_longhash(this, blob, pow, height - 1, bh.major_version, nullptr, 0))
+      continue;
+    if (!check_hash(pow, sim_block_difficulty_at(height - 1)))
+      continue;
+
+    // Lateness: received uncles are held to Def.1; never-received ones
+    // count (trustless — the PoW above is their proof of reality).
+    auto it = m_sim_recv.find(uncle_id);
+    if (it != m_sim_recv.end() && !sim_pop_in_time(uncle_id, height - 1))
+      continue;
+    ++bonus;
+  }
+  return bonus;
+}
+
+// SIMULATION ONLY (Share-or-Perish, MRL #146, step 2): admit a workshare
+// into the per-node pool. Validation here is intentionally light — canonical
+// parse plus "continues a block we know" (main or alt at height-1); the full
+// PoW check (>= diff/w at this height) is deferred to weight time, exactly
+// like embedded uncle headers. First-seen time goes into the shared
+// m_sim_recv ledger so l_b and l_w read one clock. Returns true only for a
+// NEW share (duplicates keep their first-seen and do not re-relay).
+bool Blockchain::sim_add_workshare(const blobdata &blob, uint64_t height, bool local, crypto::hash &id)
+{
+  CRITICAL_REGION_LOCAL(m_blockchain_lock);
+  if (height < 1 || height > get_current_blockchain_height())
+  {
+    MINFO("SIM-SoP: share rejected (height " << height << " vs chain height " << get_current_blockchain_height() << ")");
+    return false;
+  }
+  block_header bh;
+  uint64_t tx_count = 0;
+  if (!sim_parse_pow_header(blob, bh, tx_count))
+  {
+    MINFO("SIM-SoP: share rejected (unparsable, " << blob.size() << " B)");
+    return false;
+  }
+
+  // The share must continue something we know at height-1: the main-chain
+  // block, or an alt block competing there (during races the template's
+  // parent can itself be off the main chain).
+  bool parent_known = get_block_id_by_height(height - 1) == bh.prev_id;
+  if (!parent_known)
+  {
+    m_db->for_all_alt_blocks([&](const crypto::hash &alt_id, const alt_block_data_t &data, const cryptonote::blobdata_ref*) {
+        if (data.height == height - 1 && alt_id == bh.prev_id)
+          parent_known = true;
+        return true;
+    });
+  }
+  if (!parent_known)
+  {
+    MINFO("SIM-SoP: share rejected (unknown parent " << bh.prev_id << " at height " << (height - 1) << ")");
+    return false;
+  }
+
+  cn_fast_hash(blob.data(), blob.size(), id);
+  if (m_sim_shares.count(id))
+    return false;
+  const uint64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::system_clock::now().time_since_epoch()).count();
+  // Same clock and same emplace semantics as block receives: re-submissions
+  // and P2P duplicates never move the first-seen timestamp.
+  m_sim_recv.emplace(id, now_ms);
+  if (local)
+    m_btc_valid = false;   // a new own share must reach the next template
+  sim_workshare_entry ent;
+  ent.height = height;
+  ent.prev_id = bh.prev_id;
+  ent.recv_ms = now_ms;
+  ent.blob = blob;
+  ent.local = local;
+  ent.seq = bh.minor_version;   // the slot the share was mined under (#146)
+  m_sim_shares.emplace(id, ent);
+  // Bound the pool by first-seen order (rates are ~w-1 per block per miner;
+  // 1024 covers many heights of multi-miner gossip).
+  if (m_sim_shares.size() > 1024)
+  {
+    auto oldest = m_sim_shares.begin();
+    for (auto it = m_sim_shares.begin(); it != m_sim_shares.end(); ++it)
+      if (it->second.recv_ms < oldest->second.recv_ms)
+        oldest = it;
+    m_sim_shares.erase(oldest);
+  }
+  return true;
+}
+
+// Difficulty at `h` for weight/PoW purposes. Alt-chain blocks may sit above
+// the main-chain tip, where the main DB has no row (the lookup threw
+// "difficulty not in db" and rejected every LONGER alt chain in the SoP v1
+// and ramp-era v2 runs, review F3): such heights take the tip's difficulty
+// (exact under fixed difficulty, an approximation under LWMA).
+difficulty_type Blockchain::sim_block_difficulty_at(uint64_t h) const
+{
+  const uint64_t top = m_db->height() - 1;
+  return m_db->get_block_difficulty(h <= top ? h : top);
+}
+
+// Earliest local receive time of ANY block (main or alt) at `height`.
+uint64_t Blockchain::sim_pop_first_seen(uint64_t height) const
+{
+  uint64_t first = std::numeric_limits<uint64_t>::max();
+  auto main_it = m_sim_recv.find(get_block_id_by_height(height));
+  if (main_it != m_sim_recv.end())
+    first = std::min(first, main_it->second);
+  m_db->for_all_alt_blocks([&](const crypto::hash &alt_id, const alt_block_data_t &data, const cryptonote::blobdata_ref*) {
+      if (data.height == height)
+      {
+        auto it = m_sim_recv.find(alt_id);
+        if (it != m_sim_recv.end())
+          first = std::min(first, it->second);
+      }
+      return true;
+  });
+  return first;
+}
+
+bool Blockchain::sim_pop_in_time(const crypto::hash &id, uint64_t height) const
+{
+  auto it = m_sim_recv.find(id);
+  if (it == m_sim_recv.end())
+    return true;   // receive time unknown (never happens when enabled from init): permissive
+  const uint64_t first = sim_pop_first_seen(height);
+  if (first == std::numeric_limits<uint64_t>::max())
+    return true;   // the only block ever seen at this height
+  return it->second <= first + m_sim_pop_delay_ms;
+}
+
+bool Blockchain::sim_pop_find_uncle(uint64_t parent_height, crypto::hash &uncle_id) const
+{
+  if (parent_height < 1)
+    return false;
+  const crypto::hash parent_prev = get_block_id_by_height(parent_height - 1);
+  bool found = false;
+  m_db->for_all_alt_blocks([&](const crypto::hash &alt_id, const alt_block_data_t &data, const cryptonote::blobdata_ref*) {
+      if (found || data.height != parent_height)
+        return true;
+      cryptonote::blobdata blob;
+      cryptonote::alt_block_data_t d2;
+      if (!m_db->get_alt_block(alt_id, &d2, &blob))
+        return true;
+      cryptonote::block alt_bl;
+      if (!cryptonote::parse_and_validate_block_from_blob(blob, alt_bl))
+        return true;
+      if (alt_bl.prev_id != parent_prev)
+        return true;
+      if (!sim_pop_in_time(alt_id, parent_height))
+        return true;
+      uncle_id = alt_id;
+      found = true;
+      return true;
+  });
+  return found;
+}
+
+uint64_t Blockchain::sim_pop_uncle_bonus(const block &b, uint64_t height) const
+{
+  std::vector<tx_extra_field> fields;
+  if (!parse_tx_extra(b.miner_tx.extra, fields))
+    return 0;
+  static constexpr size_t MAGIC_LEN = sizeof(SIM_POP_UNCLE_MAGIC) - 1;
+  uint64_t bonus = 0;
+  for (const auto &f : fields)
+  {
+    if (f.which() != 2)
+      continue;
+    const std::string &nonce = boost::get<tx_extra_nonce>(f).nonce;
+    const size_t pos = nonce.find(SIM_POP_UNCLE_MAGIC, 0, MAGIC_LEN);
+    if (pos == std::string::npos || pos + MAGIC_LEN + sizeof(crypto::hash) > nonce.size())
+      continue;
+    crypto::hash uncle_id;
+    memcpy(&uncle_id, nonce.data() + pos + MAGIC_LEN, sizeof(crypto::hash));
+    if (m_sim_recv.find(uncle_id) == m_sim_recv.end())
+      continue;
+    if (!sim_pop_in_time(uncle_id, height - 1))
+      continue;
+    cryptonote::alt_block_data_t data;
+    cryptonote::blobdata blob;
+    if (!m_db->get_alt_block(uncle_id, &data, &blob) || data.height != height - 1)
+      continue;
+    ++bonus;
+  }
+  return bonus;
+}
+
+// The PoP reorg decision, replacing the raw cumulative-difficulty comparison
+// for the alt block that just arrived (alt_chain already contains `bei`).
+// --- MRL #146 share records ----------------------------------------------
+// One embedded workshare: varint seq, varint timestamp, 4B nonce (LE),
+// 32B tx_tree_hash, varint num_transactions. version_major/prev_id/
+// version_minor come from the containing block (version_minor == the
+// share's slot). Each share records the tree hash it was MINED under, so
+// shares verify independently of the block's final coinbase.
+template<typename T>
+static void sim_sop_append_varint(T &out, uint64_t v)
+{
+  for (;;)
+  {
+    uint8_t byte = v & 0x7f;
+    v >>= 7;
+    if (v)
+      byte |= 0x80;
+    out.push_back(byte);
+    if (!v)
+      return;
+  }
+}
+
+static bool sim_sop_read_varint(const std::string &in, size_t &pos, uint64_t &v)
+{
+  v = 0; uint64_t shift = 0;
+  while (pos < in.size())
+  {
+    const uint8_t byte = (uint8_t)in[pos++];
+    v |= (uint64_t)(byte & 0x7f) << shift;
+    shift += 7;
+    if (!(byte & 0x80))
+      return true;
+  }
+  return false;
+}
+
+static blobdata sim_sop_share_record(uint64_t seq, const block_header &bh,
+                                     const std::string &tree_hash, uint64_t num_tx)
+{
+  blobdata rec;
+  sim_sop_append_varint(rec, seq);
+  sim_sop_append_varint(rec, bh.timestamp);
+  const uint8_t *nonce_bytes = reinterpret_cast<const uint8_t*>(&bh.nonce);
+  for (size_t i = 0; i < sizeof(bh.nonce); ++i)   // little-endian, host is LE
+    rec.push_back(nonce_bytes[i]);
+  rec.insert(rec.end(), tree_hash.begin(), tree_hash.end());
+  sim_sop_append_varint(rec, num_tx);
+  return rec;
+}
+
+static bool sim_sop_parse_share_record(const std::string &rec, uint64_t &seq,
+                                       block_header &bh, std::string &tree_hash,
+                                       uint64_t &num_tx)
+{
+  size_t pos = 0;
+  if (!sim_sop_read_varint(rec, pos, seq))
+    return false;
+  if (!sim_sop_read_varint(rec, pos, bh.timestamp))
+    return false;
+  if (pos + sizeof(uint32_t) + 32 > rec.size())
+    return false;
+  memcpy(&bh.nonce, rec.data() + pos, sizeof(uint32_t));
+  pos += sizeof(uint32_t);
+  tree_hash.assign(rec, pos, 32);
+  pos += 32;
+  if (!sim_sop_read_varint(rec, pos, num_tx))
+    return false;
+  return pos == rec.size();
+}
+
+// SIMULATION ONLY (Share-or-Perish, MRL #146, step 3): per-block weight.
+// Within the last 10*w blocks of the tip: l_b * (diff/w) * (1 + counted
+// shares); a share counts when its parent matches the candidate block's
+// parent, its PoW meets diff/w (lazy, cached), and it was first seen > d
+// BEFORE the first block at its height (l_w — the rule that reaches
+// proactive releases: a withheld share released with its block is late).
+// Older blocks weigh plain difficulty (legacy-compatible). Zero when the
+// block itself is late (l_b = 0).
+difficulty_type Blockchain::sim_sop_weight(uint64_t height, const cryptonote::block &bl, difficulty_type diff)
+{
+  // `diff` is the block's own difficulty, supplied by the caller: for alt
+  // blocks from the alt chain's cumulative-difficulty deltas (the main DB has
+  // no row above the tip, review F3), for main blocks from the DB.
+  const uint64_t top = m_db->height() - 1;
+  if (height + 10 * m_sim_sop_w <= top)
+    return diff;                       // legacy window: share weight is 0
+  difficulty_type unit = diff / m_sim_sop_w;
+  if (unit == 0)
+    unit = 1;   // sim-only floor: bootstrap difficulties < w would zero every
+                // block (real Monero never sees diff < w)
+
+  // l_b: the block is late iff first seen > d after the first block at its
+  // height (subjective, per #146; the h0/nf gates live in should_switch).
+  const uint64_t first = sim_pop_first_seen(height);
+  const crypto::hash id = get_block_hash(bl);
+  auto bit = m_sim_recv.find(id);
+  bool lb = true;
+  if (bit != m_sim_recv.end() && first != std::numeric_limits<uint64_t>::max()
+      && bit->second > first + m_sim_sop_delay_ms)
+    lb = false;
+  difficulty_type wgt = lb ? unit : 0;
+
+  // Embedded shares (#146 option 1, tx_extra tag 0x76): slots must run
+  // 0..N-1 with block.minor_version == N; each share's PoW must meet
+  // diff/w at this height (header reconstructed from the block's
+  // major_version/prev_id + the share's own slot/timestamp/nonce/tree/
+  // num_tx); l_w counts it only when first seen > d before the first
+  // block at the height (main_seen falls back to this block's own seen
+  // time when no main block exists there, per the spec).
+  std::vector<tx_extra_field> fields;
+  if (!parse_tx_extra(bl.miner_tx.extra, fields))
+    return wgt;
+  uint64_t n = 0;
+  bool seq_ok = true;
+  for (const auto &f : fields)
+  {
+    if (f.which() != 7)          // variant: ..., 6 sim_uncle, 7 sim_workshare
+      continue;
+    ++n;
+    uint64_t seq = 0, num_tx = 0;
+    block_header sh;
+    blobdata tree;
+    if (!sim_sop_parse_share_record(boost::get<tx_extra_sim_workshare>(f).data,
+                                    seq, sh, tree, num_tx)
+        || seq != n - 1)
+    { seq_ok = false; break; }
+    sh.major_version = bl.major_version;
+    sh.minor_version = seq;             // the slot the share was mined under (#146)
+    sh.prev_id = bl.prev_id;
+    blobdata hb;
+    if (!::serialization::dump_binary(sh, hb))
+    { seq_ok = false; break; }
+    // The share's ORIGINAL PoW blob: its header, the tree hash it was mined
+    // under, its tx count. Hash THIS blob (blobdata overload). Rebuilding a
+    // block and hashing that recomputes the tree hash from an empty coinbase
+    // (and appends the wrong count), so no share ever verified at real
+    // difficulty before 2026-09-25 (review F2); the id below must also be
+    // the id the pool stamped, i.e. the hash of the same blob.
+    blobdata share_blob = hb;
+    share_blob.insert(share_blob.end(), tree.begin(), tree.end());
+    sim_sop_append_varint(share_blob, num_tx);
+    const difficulty_type share_target = diff / m_sim_sop_w ? diff / m_sim_sop_w : 1;
+    crypto::hash pow;
+    if (!get_block_longhash(this, share_blob, pow, height, bl.major_version, nullptr, 0)
+        || !check_hash(pow, share_target))
+    { seq_ok = false; break; }
+    crypto::hash sid;
+    cn_fast_hash(share_blob.data(), share_blob.size(), sid);
+    auto sit = m_sim_recv.find(sid);
+    if (sit == m_sim_recv.end())
+      continue;                        // never gossiped here: not seen early
+    uint64_t main_seen = first;
+    if (main_seen == std::numeric_limits<uint64_t>::max() && bit != m_sim_recv.end())
+      main_seen = bit->second;         // alt ahead: main_seen = block_seen
+    if (main_seen != std::numeric_limits<uint64_t>::max()
+        && main_seen > sit->second + m_sim_sop_delay_ms)
+      wgt += unit;
+  }
+  if (!seq_ok || n != bl.minor_version)
+    return lb ? unit : 0;              // non-conforming share set counts zero
+  return wgt;
+}
+
+uint64_t Blockchain::sim_sop_embedded_share_count(const cryptonote::block &bl)
+{
+  std::vector<tx_extra_field> fields;
+  if (!parse_tx_extra(bl.miner_tx.extra, fields))
+    return 0;
+  uint64_t n = 0;
+  for (const auto &f : fields)
+    if (f.which() == 7)
+      ++n;
+  return n;
+}
+
+// SIMULATION ONLY (Share-or-Perish): the #146 fork choice — PoP's skeleton
+// (rule-1 fail-safe, rule-3 tie) with the share-aware weight table above.
+bool Blockchain::sim_sop_should_switch(const std::list<block_extended_info> &alt_chain, const block_extended_info &bei)
+{
+  const uint64_t top = m_db->height() - 1;
+  const uint64_t hf = alt_chain.front().height;       // fork height (#146)
+  const uint64_t fork = hf - 1;
+  const uint64_t alt_len = alt_chain.size();
+  const uint64_t main_len = top > fork ? top - fork : 0;
+
+  // #146 subjectivity gate: the lateness factors apply only when this node
+  // was online before the fork (h0 < hf) AND the chains differ by fewer
+  // than k*w work objects. Otherwise compare OBJECTIVE cumulative
+  // difficulty — late joiners and partition recovery converge on plain
+  // weights ("partitions resolve on average after 3 blocks, when the
+  // objective chain weights kick in").
+  uint64_t nf = 0;
+  for (const auto &e : alt_chain)
+    nf += 1 + sim_sop_embedded_share_count(e.bl);
+  // The difficulty gate is sim-only: at fakechain bootstrap difficulty
+  // (< w) every weight collapses to the unit floor and forks degenerate
+  // into per-node random ties that livelock the race point. Real Monero
+  // never sees diff < w, so subjectivity engaging only there matches the
+  // spec's regime.
+  // Alt-block difficulties come from the alt chain's own cumulative
+  // deltas (no main-DB row exists above the tip, review F3).
+  const difficulty_type fork_cum = m_db->get_block_cumulative_difficulty(fork);
+  const difficulty_type alt_front_diff = alt_chain.front().cumulative_difficulty > fork_cum
+      ? alt_chain.front().cumulative_difficulty - fork_cum : 0;
+  const bool subjective = m_sim_sop_h0 < hf && nf < m_sim_sop_k * m_sim_sop_w
+      && alt_front_diff >= m_sim_sop_w;
+  if (!subjective)
+  {
+    const difficulty_type main_cum = m_db->get_block_cumulative_difficulty(top);
+    const bool sw = main_cum < bei.cumulative_difficulty;
+    MINFO("SIM-SoP: fork " << fork << " OBJECTIVE alt " << bei.cumulative_difficulty
+          << "/" << alt_len << " vs main " << main_cum << "/" << main_len
+          << " (h0=" << m_sim_sop_h0 << " nf=" << nf << ") -> "
+          << (sw ? "SWITCH" : "KEEP"));
+    return sw;
+  }
+
+  // Subjective regime: #146 weight table over the divergent suffixes.
+  difficulty_type w_alt = 0, w_main = 0;
+  difficulty_type prev_cum = fork_cum;
+  for (const auto &e : alt_chain)
+  {
+    const difficulty_type d = e.cumulative_difficulty > prev_cum ? e.cumulative_difficulty - prev_cum : 0;
+    prev_cum = e.cumulative_difficulty;
+    w_alt += sim_sop_weight(e.height, e.bl, d);
+  }
+  for (uint64_t h = fork + 1; h <= top; ++h)
+  {
+    cryptonote::block main_bl;
+    if (!get_block_by_hash(get_block_id_by_height(h), main_bl))
+      continue;
+    w_main += sim_sop_weight(h, main_bl, m_db->get_block_difficulty(h));
+  }
+
+  if (w_alt != w_main)
+  {
+    MINFO("SIM-SoP: fork " << fork << " alt " << w_alt << "/" << alt_len
+          << " vs main " << w_main << "/" << main_len
+          << " -> " << (w_alt > w_main ? "SWITCH" : "KEEP"));
+    return w_alt > w_main;
+  }
+
+  // Exact weight tie: uniform random (the spec; det via the PoP flag).
+  const bool sw = m_sim_pop_det_tie
+    ? bool(get_block_hash(bei.bl) < get_block_id_by_height(top))
+    : bool(m_sim_pop_rng() & 1);
+  MINFO("SIM-SoP: fork " << fork << " TIE " << w_alt << "/" << alt_len
+        << " vs " << w_main << "/" << main_len
+        << " -> " << (sw ? "SWITCH" : "KEEP") << " ("
+        << (m_sim_pop_det_tie ? "det" : "random") << " tie)");
+  return sw;
+}
+
+void Blockchain::set_sim_sop(uint64_t w, uint64_t delay_ms, uint64_t k)
+{
+  m_sim_sop_w = w > 1 ? w : 2;
+  m_sim_sop_delay_ms = delay_ms;
+  m_sim_sop_k = k;
+  m_sim_sop_enabled = true;
+  m_sim_pop_enabled = true;   // arms the receive-time ledger (l_b/l_w clock)
+  m_sim_sop_h0 = get_current_blockchain_height() > 1 ? get_current_blockchain_height() - 1 : 0;   // #146 h0: height when this node came online (genesis nodes: 0 — h0 < hf must hold for fork 0 too, else a bootstrap-era banked chain dominates objectively forever)
+  MINFO("SIM-SoP: weight table armed (w=" << m_sim_sop_w
+        << " delay_ms=" << delay_ms << " k=" << k << ")");
+}
+
+bool Blockchain::sim_pop_should_switch(const std::list<block_extended_info> &alt_chain, const block_extended_info &bei)
+{
+  if (m_sim_sop_enabled)
+    return sim_sop_should_switch(alt_chain, bei);   // #146 weight table
+
+  const uint64_t top = m_db->height() - 1;              // main-chain top index
+  const uint64_t fork = alt_chain.front().height - 1;   // last common-ancestor index
+  const uint64_t alt_len = alt_chain.size();
+  const uint64_t main_len = top > fork ? top - fork : 0;
+
+  // Rule 1: longest-chain fail-safe -- a chain k+ blocks longer always wins,
+  // so network partitions always resolve (same k role as the paper / #144).
+  if (alt_len >= main_len + m_sim_pop_k)
+    return true;
+
+  // Rule 2: larger in-time weight over the divergent suffixes.
+  difficulty_type w_alt = 0, w_main = 0;
+  for (const auto &e : alt_chain)
+    if (sim_pop_in_time(get_block_hash(e.bl), e.height))
+      w_alt += 1 + (m_sim_pop_uncles ? sim_pop_uncle_bonus(e.bl, e.height)
+                   : m_sim_pop_uncles_header ? sim_pop_uncle_bonus_header(e.bl, e.height) : 0);
+  for (uint64_t h = fork + 1; h <= top; ++h)
+    if (sim_pop_in_time(get_block_id_by_height(h), h))
+    {
+      ++w_main;
+      if (m_sim_pop_uncles)
+      {
+        cryptonote::block main_bl;
+        if (get_block_by_hash(get_block_id_by_height(h), main_bl))
+          w_main += m_sim_pop_uncles ? sim_pop_uncle_bonus(main_bl, h)
+                   : sim_pop_uncle_bonus_header(main_bl, h);
+      }
+    }
+
+  if (w_alt != w_main)
+  {
+    MINFO("SIM-PoP: fork " << fork << " alt " << w_alt << "/" << alt_len
+          << " vs main " << w_main << "/" << main_len
+          << " -> " << (w_alt > w_main ? "SWITCH" : "KEEP"));
+    return w_alt > w_main;
+  }
+
+  // Rule 3: exact weight tie -- uniform random (the paper) or deterministic
+  // tip-hash comparison (MRL #144's tweak, keeps the network consistent).
+  const bool sw = m_sim_pop_det_tie
+    ? bool(get_block_hash(bei.bl) < get_block_id_by_height(top))
+    : bool(m_sim_pop_rng() & 1);
+  MINFO("SIM-PoP: fork " << fork << " TIE " << w_alt << "/" << alt_len
+        << " vs " << w_main << "/" << main_len
+        << " -> " << (sw ? "SWITCH" : "KEEP") << " ("
+        << (m_sim_pop_det_tie ? "det" : "random") << " tie)");
+  return sw;
+}
