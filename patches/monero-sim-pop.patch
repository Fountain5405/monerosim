 // if that chain is long enough to become the main chain and re-org accordingly
 // if so.  If not, we need to hang on to the block in case it becomes part of
 // a long forked chain eventually.
+//------------------------------------------------------------------
+// SIMULATION ONLY: Publish-or-Perish weighted fork-resolving policy
+// (patches/monero-sim-pop.patch). Inactive unless set_sim_pop() was called
+// (daemon flags --sim-publish-or-perish / --sim-pop-k / --sim-pop-delay-s /
+// --sim-pop-det-tie, wired in cryptonote_core.cpp); with the flag absent the
+// reorg decision below is byte-for-byte stock.
+//
+// A block is IN TIME (Zhang-Preneel CT-RSA 2017 Def. 1) when it was first
+// received by this node no later than m_sim_pop_delay_ms after the earliest
+// block this node has ever received at the same height -- a purely relative
+// measurement, no clock sync. Late blocks contribute zero to their chain's
+// in-time weight. Uncles (Def. 2/3's second term) are NOT modeled: this
+// patch measures the fork-choice core alone.
+void Blockchain::set_sim_pop(uint64_t k, uint64_t delay_ms, bool det_tie)
+{
+  m_sim_pop_enabled = true;
+  m_sim_pop_k = k;
+  m_sim_pop_delay_ms = delay_ms;
+  m_sim_pop_det_tie = det_tie;
+  m_sim_pop_rng.seed(std::random_device{}());
+  MGINFO("*** SIMULATION: --sim-publish-or-perish is ON (k=" << k
+         << ", delay=" << delay_ms << "ms, "
+         << (det_tie ? "deterministic" : "random") << " tie-break; no uncles) ***");
+}
+
+// Earliest local receive time of ANY block (main or alt) at `height`.
+uint64_t Blockchain::sim_pop_first_seen(uint64_t height) const
+{
+  uint64_t first = std::numeric_limits<uint64_t>::max();
+  auto main_it = m_sim_recv.find(get_block_id_by_height(height));
+  if (main_it != m_sim_recv.end())
+    first = std::min(first, main_it->second);
+  m_db->for_all_alt_blocks([&](const crypto::hash &alt_id, const alt_block_data_t &data, const cryptonote::blobdata_ref*) {
+      if (data.height == height)
+      {
+        auto it = m_sim_recv.find(alt_id);
+        if (it != m_sim_recv.end())
+          first = std::min(first, it->second);
+      }
+      return true;
+  });
+  return first;
+}
+
+bool Blockchain::sim_pop_in_time(const crypto::hash &id, uint64_t height) const
+{
+  auto it = m_sim_recv.find(id);
+  if (it == m_sim_recv.end())
+    return true;   // receive time unknown (never happens when enabled from init): permissive
+  const uint64_t first = sim_pop_first_seen(height);
+  if (first == std::numeric_limits<uint64_t>::max())
+    return true;   // the only block ever seen at this height
+  return it->second <= first + m_sim_pop_delay_ms;
+}
+
+// The PoP reorg decision, replacing the raw cumulative-difficulty comparison
+// for the alt block that just arrived (alt_chain already contains `bei`).
+bool Blockchain::sim_pop_should_switch(const std::list<block_extended_info> &alt_chain, const block_extended_info &bei)
+{
+  const uint64_t top = m_db->height() - 1;              // main-chain top index
+  const uint64_t fork = alt_chain.front().height - 1;   // last common-ancestor index
+  const uint64_t alt_len = alt_chain.size();
+  const uint64_t main_len = top > fork ? top - fork : 0;
+
+  // Rule 1: longest-chain fail-safe -- a chain k+ blocks longer always wins,
+  // so network partitions always resolve (same k role as the paper / #144).
+  if (alt_len >= main_len + m_sim_pop_k)
+    return true;
+
+  // Rule 2: larger in-time weight over the divergent suffixes.
+  uint64_t w_alt = 0, w_main = 0;
+  for (const auto &e : alt_chain)
+    if (sim_pop_in_time(get_block_hash(e.bl), e.height))
+      ++w_alt;
+  for (uint64_t h = fork + 1; h <= top; ++h)
+    if (sim_pop_in_time(get_block_id_by_height(h), h))
+      ++w_main;
+
+  if (w_alt != w_main)
+  {
+    MINFO("SIM-PoP: fork " << fork << " alt " << w_alt << "/" << alt_len
+          << " vs main " << w_main << "/" << main_len
+          << " -> " << (w_alt > w_main ? "SWITCH" : "KEEP"));
+    return w_alt > w_main;
+  }
+
+  // Rule 3: exact weight tie -- uniform random (the paper) or deterministic
+  // tip-hash comparison (MRL #144's tweak, keeps the network consistent).
+  const bool sw = m_sim_pop_det_tie
+    ? bool(get_block_hash(bei.bl) < get_block_id_by_height(top))
+    : bool(m_sim_pop_rng() & 1);
+  MINFO("SIM-PoP: fork " << fork << " TIE " << w_alt << "/" << alt_len
+        << " vs " << w_main << "/" << main_len
+        << " -> " << (sw ? "SWITCH" : "KEEP") << " ("
+        << (m_sim_pop_det_tie ? "det" : "random") << " tie)");
+  return sw;
+}
