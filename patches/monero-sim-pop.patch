+      // peer_id also filters out connections before handshake; state_normal
+      // keeps share gossip OFF syncing connections — spans and share bursts
+      // multiplexing on one connection measurably amplify chain-sync churn
+      // (invalid-span drops), and a syncing peer would reject the share
+      // anyway (unknown parent).
+      if (peer_id && exclude_context.m_connection_id != context.m_connection_id
+          && context.m_state == cryptonote_connection_context::state_normal
+          && context.m_remote_address.get_zone() == epee::net_utils::zone::public_)
+        connections.push_back({context.m_remote_address.get_zone(), context.m_connection_id});
