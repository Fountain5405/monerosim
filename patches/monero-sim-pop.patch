+void Blockchain::set_sim_pop(uint64_t k, uint64_t delay_ms, bool det_tie, bool uncles, bool uncles_header)
+{
+  m_sim_pop_enabled = true;
+  m_sim_pop_k = k;
+  m_sim_pop_delay_ms = delay_ms;
+  m_sim_pop_det_tie = det_tie;
+  m_sim_pop_uncles = uncles;
+  m_sim_pop_uncles_header = uncles_header;
+  m_sim_pop_rng.seed(std::random_device{}());
+  MGINFO("*** SIMULATION: --sim-publish-or-perish is ON (k=" << k
+         << ", delay=" << delay_ms << "ms, "
+         << (det_tie ? "deterministic" : "random") << " tie-break, "
+         << (uncles ? "WITH uncles (id-in-nonce, DEVIATED)" : "")
+         << (uncles_header ? "WITH uncles (80B PoW header, MRL #144 exact)" : "")
+         << ((!uncles && !uncles_header) ? "no uncles" : "") << ") ***");
