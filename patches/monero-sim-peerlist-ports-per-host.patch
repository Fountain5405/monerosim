+TEST(peer_list, per_host_v4_mapped_ipv6_same_host)
+{
+  nodetool::peerlist_manager plm;
+  plm.init(nodetool::peerlist_types{}, false);
+  plm.set_ports_per_host_limit(1);
+  nodetool::peerlist_entry ple{};
+  ple.adr = epee::net_utils::ipv4_network_address{MAKE_IP(1,2,3,4), 1001}; ple.id = 1; ple.last_seen = 5;
+  plm.append_with_peer_gray(ple);
+  ple.adr = epee::net_utils::ipv6_network_address{boost::asio::ip::make_address_v6(boost::asio::ip::v4_mapped, boost::asio::ip::address_v4{MAKE_IP(1,2,3,4)}), 1002}; ple.id = 2; ple.last_seen = 6;
+  plm.append_with_peer_gray(ple);
+  ASSERT_EQ(plm.get_gray_peers_count(), 1u); // v4-mapped ipv6 collapses onto the ipv4 host key
+  std::vector<nodetool::peerlist_entry> g, w;
+  plm.get_peerlist(g, w);
+  ASSERT_EQ(g.size(), 1u);
+  ASSERT_EQ(g[0].adr.get_type_id(), epee::net_utils::ipv6_network_address::get_type_id());
+}
