+TEST(peer_list, per_host_stock_white_one_per_host)
+{
+  nodetool::peerlist_manager plm;
+  plm.init(nodetool::peerlist_types{}, false);
+  nodetool::peerlist_entry ple{};
+  ple.adr = epee::net_utils::ipv4_network_address{MAKE_IP(123,43,12,1), 8080}; ple.id = 1; ple.last_seen = 1000;
+  plm.append_with_peer_white(ple);
+  ple.adr = epee::net_utils::ipv4_network_address{MAKE_IP(123,43,12,1), 8081}; ple.id = 2; ple.last_seen = 2000;
+  plm.append_with_peer_white(ple);
+  ASSERT_EQ(plm.get_white_peers_count(), 1u); // stock: white is one-per-host, newest port wins
+  std::vector<nodetool::peerlist_entry> g, w;
+  plm.get_peerlist(g, w);
+  ASSERT_EQ(w.size(), 1u);
+  ASSERT_EQ(w[0].adr.as<const epee::net_utils::ipv4_network_address>().port(), 8081);
+}
+
+TEST(peer_list, per_host_gray_cap_keeps_newest)
+{
+  nodetool::peerlist_manager plm;
+  plm.init(nodetool::peerlist_types{}, false);
+  plm.set_ports_per_host_limit(1);
+  for (uint16_t port = 1; port <= 3; ++port)
+  {
+    nodetool::peerlist_entry ple{};
+    ple.adr = epee::net_utils::ipv4_network_address{MAKE_IP(1,2,3,4), uint16_t(1000+port)};
+    ple.id = port; ple.last_seen = 1000+port;
+    plm.append_with_peer_gray(ple);
+  }
+  nodetool::peerlist_entry other{};
+  other.adr = epee::net_utils::ipv4_network_address{MAKE_IP(5,6,7,8), 8080}; other.id = 9; other.last_seen = 1;
+  plm.append_with_peer_gray(other);
+  ASSERT_EQ(plm.get_gray_peers_count(), 2u); // host's newest + the other host
+  std::vector<nodetool::peerlist_entry> g, w;
+  plm.get_peerlist(g, w);
+  for (const auto& pe : g)
+    if (pe.adr.as<const epee::net_utils::ipv4_network_address>().ip() == MAKE_IP(1,2,3,4))
+      ASSERT_EQ(pe.adr.as<const epee::net_utils::ipv4_network_address>().port(), 1003);
+}
+
+TEST(peer_list, per_host_promote_erases_gray_siblings)
+{
+  nodetool::peerlist_manager plm;
+  plm.init(nodetool::peerlist_types{}, false);
+  plm.set_ports_per_host_limit(1);
+  nodetool::peerlist_entry ple{};
+  ple.adr = epee::net_utils::ipv4_network_address{MAKE_IP(1,2,3,4), 1001}; ple.id = 1; ple.last_seen = 1000;
+  plm.append_with_peer_gray(ple);
+  ple.adr = epee::net_utils::ipv4_network_address{MAKE_IP(1,2,3,4), 1002}; ple.id = 2; ple.last_seen = 1001;
+  plm.append_with_peer_gray(ple);
+  ple.adr = epee::net_utils::ipv4_network_address{MAKE_IP(5,6,7,8), 8080}; ple.id = 9; ple.last_seen = 1;
+  plm.append_with_peer_gray(ple);
+  ASSERT_EQ(plm.get_gray_peers_count(), 2u); // the cap already evicted H:1001 when H:1002 arrived
+  nodetool::peerlist_entry promote{};
+  promote.adr = epee::net_utils::ipv4_network_address{MAKE_IP(1,2,3,4), 1002}; promote.id = 2; promote.last_seen = 2000;
+  plm.append_with_peer_white(promote);
+  ASSERT_EQ(plm.get_white_peers_count(), 1u);
+  ASSERT_EQ(plm.get_gray_peers_count(), 1u); // only the other host remains: both same-host gray rows erased
+  std::vector<nodetool::peerlist_entry> g, w;
+  plm.get_peerlist(g, w);
+  ASSERT_EQ(g[0].adr.as<const epee::net_utils::ipv4_network_address>().ip(), MAKE_IP(5,6,7,8));
+}
+
+TEST(peer_list, per_host_stock_noop_zero_limit)
+{
+  nodetool::peerlist_manager plm;
+  plm.init(nodetool::peerlist_types{}, false); // limit 0 = stock
+  nodetool::peerlist_entry ple{};
+  ple.adr = epee::net_utils::ipv4_network_address{MAKE_IP(1,2,3,4), 1001}; ple.id = 1; ple.last_seen = 1000;
+  plm.append_with_peer_gray(ple);
+  ple.adr = epee::net_utils::ipv4_network_address{MAKE_IP(1,2,3,4), 1002}; ple.id = 2; ple.last_seen = 1001;
+  plm.append_with_peer_gray(ple);
+  ASSERT_EQ(plm.get_gray_peers_count(), 2u); // stock: no per-host gray cap
+  nodetool::peerlist_entry promote{};
+  promote.adr = epee::net_utils::ipv4_network_address{MAKE_IP(1,2,3,4), 1002}; promote.id = 2; promote.last_seen = 2000;
+  plm.append_with_peer_white(promote);
+  ASSERT_EQ(plm.get_gray_peers_count(), 1u); // stock: only the same-ADDRESS gray row is erased; H:1001 stays (the pump's reservoir)
+  ASSERT_EQ(plm.get_white_peers_count(), 1u);
+  promote.adr = epee::net_utils::ipv4_network_address{MAKE_IP(1,2,3,4), 1001}; promote.id = 1; promote.last_seen = 3000;
+  plm.append_with_peer_white(promote);
+  ASSERT_EQ(plm.get_white_peers_count(), 1u); // stock: same-host white eviction, now H:1001
+  ASSERT_EQ(plm.get_gray_peers_count(), 0u);
+}
