diff --git a/tests/unit_tests/block_reward.cpp b/tests/unit_tests/block_reward.cpp
index 9d06c8e86..cc4fccd23 100644
--- a/tests/unit_tests/block_reward.cpp
+++ b/tests/unit_tests/block_reward.cpp
@@ -230,4 +230,35 @@ namespace
     ASSERT_TRUE(m_block_not_too_big);
     ASSERT_EQ(m_block_reward, m_standard_block_reward * 15 / 64);
   }
+
+  // monerosim patches/monero-sim-tail-emission.patch
+  TEST(sim_tail_emission, switches_at_height_and_keeps_penalty)
+  {
+    const uint64_t tail = FINAL_SUBSIDY_PER_MINUTE * 2; // 0.6 XMR at 2-min blocks
+    const size_t median = CRYPTONOTE_BLOCK_GRANTED_FULL_REWARD_ZONE_V5;
+    uint64_t r = 0, stock = 0;
+    ASSERT_TRUE(get_block_reward(median, 1, 0, stock, 16));
+    ASSERT_GT(stock, tail);
+
+    // off by default: identical to the stock function at any height
+    ASSERT_TRUE(get_block_reward_at_height(1000000, median, 1, 0, r, 16));
+    ASSERT_EQ(stock, r);
+
+    set_sim_tail_emission_height(100);
+    ASSERT_TRUE(get_block_reward_at_height(99, median, 1, 0, r, 16));
+    ASSERT_EQ(stock, r);
+    ASSERT_TRUE(get_block_reward_at_height(100, median, 1, 0, r, 16));
+    ASSERT_EQ(tail, r);
+    ASSERT_TRUE(get_block_reward_at_height(5000, median, 1, 0, r, 16));
+    ASSERT_EQ(tail, r);
+    // size penalty still applies to the tail reward: 1.5 x median -> 3/4
+    ASSERT_TRUE(get_block_reward_at_height(100, median, median * 3 / 2, 0, r, 16));
+    ASSERT_EQ(tail * 3 / 4, r);
+    // and the 2 x median hard cap still holds
+    ASSERT_FALSE(get_block_reward_at_height(100, median, 2 * median + 1, 0, r, 16));
+
+    set_sim_tail_emission_height(std::numeric_limits<uint64_t>::max());
+    ASSERT_TRUE(get_block_reward_at_height(5000, median, 1, 0, r, 16));
+    ASSERT_EQ(stock, r);
+  }
 }
