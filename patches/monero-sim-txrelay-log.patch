diff --git a/src/cryptonote_protocol/sim_txrelay_log.h b/src/cryptonote_protocol/sim_txrelay_log.h
new file mode 100644
index 000000000..acc2f1d37
--- /dev/null
+++ b/src/cryptonote_protocol/sim_txrelay_log.h
@@ -0,0 +1,84 @@
+// Simulation-only addition by monerosim, under the same BSD-3-Clause license as Monero.
+
+// SIMULATION ONLY (monerosim patches/monero-sim-txrelay-log.patch): ground-truth
+// log of Dandelion++ transaction relay, enabled with --sim-log-txrelay=<file>.
+// Each line is one JSON object {"t":<unix us>,"ev":...}. Under Shadow the clock
+// is simulated time. Measurement only: nothing here changes relay behaviour.
+// Event types are documented in monerosim docs/TXRELAY_LOG.md.
+
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <mutex>
+#include <sstream>
+#include <string>
+
+#include "cryptonote_protocol/enums.h"
+
+namespace cryptonote
+{
+namespace sim_txrelay_log
+{
+  struct state
+  {
+    std::mutex lock;
+    std::atomic<std::FILE*> file{nullptr};
+  };
+
+  inline state& get_state()
+  {
+    static state s;
+    return s;
+  }
+
+  inline bool enabled() noexcept
+  {
+    return get_state().file.load(std::memory_order_acquire) != nullptr;
+  }
+
+  //! Opens `path` for appending; empty path leaves logging off. Returns false on error.
+  inline bool open(const std::string& path)
+  {
+    if (path.empty() || enabled())
+      return true;
+    std::FILE* f = std::fopen(path.c_str(), "a");
+    if (!f)
+      return false;
+    get_state().file.store(f, std::memory_order_release);
+    return true;
+  }
+
+  inline const char* relay_name(const relay_method method) noexcept
+  {
+    switch (method)
+    {
+      case relay_method::none: return "none";
+      case relay_method::local: return "local";
+      case relay_method::forward: return "forward";
+      case relay_method::stem: return "stem";
+      case relay_method::fluff: return "fluff";
+      case relay_method::block: return "block";
+    }
+    return "unknown";
+  }
+
+  //! Writes `{"t":<now>,"ev":"<ev>"<body>}`; `body` starts with a comma or is empty.
+  inline void write(const char* ev, const std::string& body)
+  {
+    state& s = get_state();
+    std::FILE* f = s.file.load(std::memory_order_acquire);
+    if (!f)
+      return;
+    const auto us = std::chrono::duration_cast<std::chrono::microseconds>(
+      std::chrono::system_clock::now().time_since_epoch()).count();
+    std::ostringstream line;
+    line << "{\"t\":" << us << ",\"ev\":\"" << ev << "\"" << body << "}\n";
+    const std::string out = line.str();
+    std::lock_guard<std::mutex> guard{s.lock};
+    std::fputs(out.c_str(), f);
+    std::fflush(f); // Shadow kills daemons at stop_time; keep every line
+  }
+} // sim_txrelay_log
+} // cryptonote
