diff --git a/src/cryptonote_protocol/sim_stemmable.h b/src/cryptonote_protocol/sim_stemmable.h
new file mode 100644
index 000000000..ffa06b09a
--- /dev/null
+++ b/src/cryptonote_protocol/sim_stemmable.h
@@ -0,0 +1,141 @@
+// SIMULATION ONLY (--sim-stemmable-inbound): tevador's MRL #160 variant of
+// stemmable inbound connections, for spy-exposure measurement.  The PoW gate
+// (sustained 0.5 MH/s of HashWX per stemmable connection) is modeled, not
+// implemented: with the flag on, an inbound connection counts as stemmable
+// when its remote IPv4 address matches --sim-stemmable-cidrs (a file of
+// a.b.c.d/len lines; no file = every inbound connection).  The stem-edge
+// selection itself is in net/dandelionpp.cpp and levin_notify.cpp: edge 1 is
+// drawn from real outgoing connections only (local transactions always use
+// it), edge 2 from the /16-deduplicated union of real outgoing connections
+// and the "virtual outgoing" list built from stemmable inbounds (one random
+// /24 per /16, one random connection per /24, capped at 12).
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace cryptonote
+{
+namespace sim_stemmable
+{
+  struct cidr
+  {
+    std::uint32_t addr;
+    std::uint32_t mask;
+  };
+
+  inline std::atomic<bool>& enabled_flag()
+  {
+    static std::atomic<bool> value{false};
+    return value;
+  }
+
+  inline std::vector<cidr>& cidrs()
+  {
+    static std::vector<cidr> value;
+    return value;
+  }
+
+  inline bool enabled()
+  {
+    return enabled_flag().load(std::memory_order_relaxed);
+  }
+
+  //! "1.2.3.4" -> host-order uint32. False on anything else.
+  inline bool parse_ipv4(const std::string& ip, std::uint32_t& out)
+  {
+    std::size_t pos = 0;
+    std::uint32_t parts[4];
+    for (int i = 0; i < 4; ++i)
+    {
+      const std::size_t next = ip.find('.', pos);
+      const std::string octet = i < 3 ? ip.substr(pos, next - pos) : ip.substr(pos);
+      if (octet.empty() || octet.size() > 3)
+        return false;
+      for (const char c : octet)
+        if (c < '0' || c > '9')
+          return false;
+      const int value = std::stoi(octet);
+      if (value < 0 || value > 255)
+        return false;
+      parts[i] = std::uint32_t(value);
+      if (i < 3 && next == std::string::npos)
+        return false;
+      pos = next + 1;
+    }
+    out = (parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3];
+    return true;
+  }
+
+  //! Enables the feature and loads the stemmable CIDR list. An empty or
+  //! missing file with `enable` means "every inbound connection is stemmable".
+  //! Returns false only when `enable` is set and the file cannot be read.
+  inline bool open(const bool enable, const std::string& cidrs_path)
+  {
+    enabled_flag().store(false, std::memory_order_relaxed);
+    cidrs().clear();
+    if (!enable)
+      return true;
+    if (!cidrs_path.empty())
+    {
+      std::ifstream in{cidrs_path};
+      if (!in)
+        return false;
+      std::string line;
+      while (std::getline(in, line))
+      {
+        const std::size_t comment = line.find('#');
+        if (comment != std::string::npos)
+          line.erase(comment);
+        while (!line.empty() && (line.back() == ' ' || line.back() == '\r' || line.back() == '\t'))
+          line.pop_back();
+        if (line.empty())
+          continue;
+        const std::size_t slash = line.find('/');
+        std::uint32_t addr;
+        if (!parse_ipv4(line.substr(0, slash), addr))
+          continue; // not a dotted quad: skip, the lab's lists are IPv4 only
+        int bits = 32;
+        if (slash != std::string::npos)
+        {
+          const std::string len = line.substr(slash + 1);
+          if (len.empty() || len.size() > 2)
+            continue;
+          for (const char c : len)
+            if (c < '0' || c > '9')
+              continue;
+          bits = std::stoi(len);
+          if (bits < 0 || bits > 32)
+            continue;
+        }
+        const std::uint32_t mask = bits == 0 ? 0 : (0xFFFFFFFFu << (32 - bits));
+        cidrs().push_back({addr, mask});
+      }
+    }
+    enabled_flag().store(true, std::memory_order_relaxed);
+    return true;
+  }
+
+  //! True when the remote address of an inbound connection ("1.2.3.4:18080")
+  //! is in the stemmable set. Requires enabled().
+  inline bool stemmable_addr(const std::string& remote)
+  {
+    if (!enabled())
+      return false;
+    const std::size_t colon = remote.find(':');
+    const std::string host = colon == std::string::npos ? remote : remote.substr(0, colon);
+    std::uint32_t addr;
+    if (!parse_ipv4(host, addr))
+      return false;
+    if (cidrs().empty())
+      return true;
+    for (const cidr& c : cidrs())
+      if ((addr & c.mask) == (c.addr & c.mask))
+        return true;
+    return false;
+  }
+}
+}
